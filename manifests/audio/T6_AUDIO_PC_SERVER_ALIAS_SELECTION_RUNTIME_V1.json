  "behavior": {
    "picker": {
      "aliasStride": 96,
      "maxVariantsExamined": 64,
      "contextTypeOffset": 36,
      "contextValueOffset": 40,
      "sequenceOffsetInList": 16,
      "rules": [
        "null list or count 0 returns null",
        "count >= 64 asserts and the examined count is clamped to 64",
        "contextType 0 is eligible",
        "an entity-context exact match is eligible",
        "contextValue 0 is an eligible wildcard",
        "otherwise the global SND context value must equal alias contextValue",
        "zero eligible aliases returns null and one eligible alias returns it",
        "flags0 bit 31 / SND_RANDOMIZE_ENTITY_VARIANT seeds RandWithSeed from alias-list pointer plus the picker integer argument; SND_PlaySoundAlias supplies SndEntHandle & 0xFFF as that integer",
        "otherwise a nonzero global seed uses RandWithSeed",
        "otherwise CRT rand() is used; for more than two eligible aliases it retries up to 100 times to avoid the prior SndAliasList.sequence index",
        "the chosen eligible index is written to SndAliasList.sequence"
      ]
    },
    "neverPlayTwice": {
      "property": "flags1 bit 0 at alias+0x1C",
      "playedState": "flags1 bit 1 at alias+0x1C",
      "enforcement": "SND_PlaySoundAlias returns -1 before secondary or driver playback when neverPlayTwice is set and playedState is already set",
      "successUpdate": "SND_PlaySoundAlias sets playedState=1 on its observed successful normal exits; SD_StartAlias failure cleans up the allocated voice and returns -1 without that update"
    },
    "probability": {
      "field": "alias+0x58 byte",
      "scale": "value / 255.0",
      "rule": "value 0 bypasses stochastic rejection; otherwise SND_PlaySoundAlias rejects only when engine random() > value/255.0"
    },
    "secondary": {
      "field": "alias+0x0C secondaryName",
      "lookup": "SND_HashName -> SND_BankAliasLookupCache",
      "missingTarget": "a null cache/lookup result skips secondary recursion and continues the primary alias play path",
      "validation": [
        "looping primary cannot chain to non-looping secondary",
        "non-looping primary cannot chain to looping secondary",
        "the secondary-name chain is checked against the starting primary alias name for recursion",
        "validation follows at most 10 secondary-chain hops"
      ],
      "archiveImplication": "For the two previously ownerless serialized secondaryName values, the exact PC-server unresolved-lookup behavior is omission of the secondary while preserving the primary play attempt."
