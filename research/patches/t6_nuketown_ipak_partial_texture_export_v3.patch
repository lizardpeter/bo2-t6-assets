+def decode_bc2(src,w,h):
+    out=bytearray(w*h*4); p=0
+    for by in range((h+3)//4):
+        for bx in range((w+3)//4):
+            abits=int.from_bytes(src[p:p+8],'little')
+            c0,c1,cbits=struct.unpack_from('<HHI',src,p+8); p+=16
+            r0,g0,b0=rgb565(c0); r1,g1,b1=rgb565(c1)
+            cols=[(r0,g0,b0),(r1,g1,b1),((2*r0+r1)//3,(2*g0+g1)//3,(2*b0+b1)//3),((r0+2*r1)//3,(g0+2*g1)//3,(b0+2*b1)//3)]
+            for py in range(4):
+                y=by*4+py
+                if y>=h: continue
+                for px in range(4):
+                    x=bx*4+px
+                    if x>=w: continue
+                    i=py*4+px; ci=(cbits>>(2*i))&3; a4=(abits>>(4*i))&0xf; o=(y*w+x)*4
+                    out[o:o+4]=bytes((*cols[ci],a4*17))
+    return bytes(out)
+
