"},{id:"urn:ure:t6:occ:function:current-client:00a35210",va:"0x00A35210",section:".text",basis:"direct-call-target",strongest_basis:"direct-call-target"},{id:"urn:ure:t6:occ:function:current-client:00a35220",va:"0x00A35220",section:".text",basis:"direct-call-target;post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:00a35230",va:"0x00A35230",section:".text",basis:"direct-call-target;post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:00a35240",va:"0x00A35240",section:".text",basis:"direct-call-target;post-int3-padding",strongest_basis:"post-int3-padding"}] AS rows
UNWIND rows AS row
MERGE (n:KGNode {id:row.id})
ON CREATE SET n.kind='re:FunctionOccurrence', n.namespace='t6', n.build_id=b.id, n.artifact_id=a.id,
    n.display_name='sub_'+substring(row.va,2), n.address_space='va', n.address_start=row.va
SET n.entry_basis=row.basis, n.entry_strongest_basis=row.strongest_basis,
    n.boundary_state=CASE WHEN coalesce(n.boundary_state,'') STARTS WITH 'exact-' THEN n.boundary_state ELSE 'entry-only-mechanical-inventory' END,
    n.scope_projection_state=coalesce(n.scope_projection_state,'pending'),
    n.producer=CASE WHEN n.producer IS NULL THEN 't6-current-client-whole-image-mechanical-inventory-v1' ELSE n.producer END
