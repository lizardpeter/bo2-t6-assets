id":"urn:ure:t6:occ:callsite:current-client:007c5977","call_va":"0x007C5977","target_va":"0x004DA190","section":".text","bytes":"e81448d1ff","caller_id":"urn:ure:t6:occ:function:current-client:007c56b0","target_id":"urn:ure:t6:occ:function:current-client:004da190"},{"id":"urn:ure:t6:occ:callsite:current-client:007c5987","call_va":"0x007C5987","target_va":"0x0042E990","section":".text","bytes":"e80490c6ff","caller_id":"urn:ure:t6:occ:function:current-client:007c56b0","target_id":"urn:ure:t6:occ:function:current-client:0042e990"},{"id":"urn:ure:t6:occ:callsite:current-client:007c5998","call_va":"0x007C5998","target_va":"0x0045D840","section":".text","bytes":"e8a37ec9ff","caller_id":"urn:ure:t6:occ:function:current-client:007c56b0","target_id":"urn:ure:t6:occ:function:current-client:0045d840"},{"id":"urn:ure:t6:occ:callsite:current-client:007c59a7","call_va":"0x007C59A7","target_va":"0x0057AFF0","section":".text","bytes":"e84456dbff","caller_id":"urn:ure:t6:occ:function:current-client:007c56b0","target_id":"urn:ure:t6:occ:function:current-client:0057aff0"},{"id":"urn:ure:t6:occ:callsite:current-client:007c59bc","call_va":"0x007C59BC","target_va":"0x00403AE0","section":".text","bytes":"e81fe1c3ff","caller_id":"urn:ure:t6:occ:function:current-client:007c56b0","target_id":"urn:ure:t6:occ:function:current-client:00403ae0"},{"id":"urn:ure:t6:occ:callsite:current-client:007c59ca","call_va":"0x007C59CA","target_va":"0x005F3530","section":".text","bytes":"e861dbe2ff","caller_id":"urn:ure:t6:occ:function:current-client:007c56b0","target_id":"urn:ure:t6:occ:function:current-client:005f3530"}] AS rows
