nt3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:005d4150","va":"0x005D4150","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:005d4210","va":"0x005D4210","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:005d44e0","va":"0x005D44E0","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:005d46a0","va":"0x005D46A0","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:005d46c0","va":"0x005D46C0","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:005d4750","va":"0x005D4750","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:005d4950","va":"0x005D4950","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:005d4a00","va":"0x005D4A00","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:005d4a20","va":"0x005D4A20","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:005d4a80","va":"0x005D4A80","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:005d4c80","va":"0x005D4C80","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"}] AS rows
UNWIND rows AS row
MERGE (n:KGNode {id:row.id})
ON CREATE SET n.kind='re:FunctionOccurrence', n.namespace='t6', n.build_id=b.id, n.artifact_id=a.id,
    n.display_name='sub_'+substring(row.va,2), n.address_space='va', n.address_start=row.va
SET n.entry_basis=row.basis, n.entry_strongest_basis=row.strongest_basis,
    n.boundary_state=CASE WHEN coalesce(n.boundary_state,'') STARTS WITH 'exact-' THEN n.boundary_state ELSE 'entry-only-mechanical-inventory' END,
    n.producer=CASE WHEN n.producer IS NULL THEN 't6-current-client-whole-image-mechanical-inventory-v1' ELSE n.producer END
MERGE (b)-[:HAS_OCCURRENCE]->(n)
MERGE (n)-[:DEFINED_IN]->(a)
