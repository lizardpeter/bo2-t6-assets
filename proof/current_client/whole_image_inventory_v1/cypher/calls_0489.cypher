id":"urn:ure:t6:occ:callsite:current-client:008f136c","call_va":"0x008F136C","target_va":"0x006C2990","section":".text","bytes":"e81f16ddff","caller_id":"urn:ure:t6:occ:function:current-client:008f12b0","target_id":"urn:ure:t6:occ:function:current-client:006c2990"},{"id":"urn:ure:t6:occ:callsite:current-client:008f1377","call_va":"0x008F1377","target_va":"0x00458900","section":".text","bytes":"e88475b6ff","caller_id":"urn:ure:t6:occ:function:current-client:008f12b0","target_id":"urn:ure:t6:occ:function:current-client:00458900"},{"id":"urn:ure:t6:occ:callsite:current-client:008f1392","call_va":"0x008F1392","target_va":"0x006D5CE0","section":".text","bytes":"e84949deff","caller_id":"urn:ure:t6:occ:function:current-client:008f12b0","target_id":"urn:ure:t6:occ:function:current-client:006d5ce0"},{"id":"urn:ure:t6:occ:callsite:current-client:008f13dc","call_va":"0x008F13DC","target_va":"0x006C2990","section":".text","bytes":"e8af15ddff","caller_id":"urn:ure:t6:occ:function:current-client:008f13b0","target_id":"urn:ure:t6:occ:function:current-client:006c2990"},{"id":"urn:ure:t6:occ:callsite:current-client:008f13e7","call_va":"0x008F13E7","target_va":"0x00458900","section":".text","bytes":"e81475b6ff","caller_id":"urn:ure:t6:occ:function:current-client:008f13b0","target_id":"urn:ure:t6:occ:function:current-client:00458900"},{"id":"urn:ure:t6:occ:callsite:current-client:008f1412","call_va":"0x008F1412","target_va":"0x005EB700","section":".text","bytes":"e8e9a2cfff","caller_id":"urn:ure:t6:occ:function:current-client:008f13b0","target_id":"urn:ure:t6:occ:function:current-client:005eb700"}] AS rows
