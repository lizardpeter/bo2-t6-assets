ent:00c364fc",va:"0x00C364FC",section:".rdata",length:47,text:"BD_CONTENTSTREAMING_DOWNLOAD_BANDWIDTH_EXCEEDED",truncated:false,sha256:"ffc39daca0a0fc061883459e7ed91d670f429987ac1980e0c1cb748280e11a75"},{id:"urn:ure:t6:occ:string:current-client:00c3652c",va:"0x00C3652C",section:".rdata",length:14,text:"lit_b0c0s0o0v0",truncated:false,sha256:"4d9d0dcabcabf0866f880c025bf405a0e6d6d69f2cc2ef8be93b68214fb77af0"},{id:"urn:ure:t6:occ:string:current-client:00c3653c",va:"0x00C3653C",section:".rdata",length:4,text:"alt1",truncated:false,sha256:"1c8a07b6f2cbbde6fd7ffeba6fa61cd790378f73b9cdd2890dea2db9ae0bf8b6"},{id:"urn:ure:t6:occ:string:current-client:00c36544",va:"0x00C36544",section:".rdata",length:13,text:"node_scripted",truncated:false,sha256:"ad279c3863dc1814ffdeb7fe39f8f260ed551faf10663cc5a3a230f1ec8c20c1"}] AS rows
UNWIND rows AS row
MERGE (n:KGNode {id:row.id})
ON CREATE SET n._mechanical_inventory_new=true
SET n.kind='core:Occurrence', n.occurrence_type='string-literal', n.namespace='t6', n.build_id=b.id, n.artifact_id=a.id,
    n.address_space='va', n.address_start=row.va, n.section_name=row.section, n.length=row.length,
    n.text=row.text, n.truncated=row.truncated, n.content_sha256=row.sha256,
    n.producer='t6-current-client-whole-image-mechanical-inventory-v1'
WITH b,a,n,coalesce(n._mechanical_inventory_new,false) AS is_new
FOREACH (_ IN CASE WHEN is_new THEN [1] ELSE [] END |
  CREATE (b)-[:HAS_OCCURRENCE]->(n)
  CREATE (n)-[:DEFINED_IN]->(a)
)
REMOVE n._mechanical_inventory_new
