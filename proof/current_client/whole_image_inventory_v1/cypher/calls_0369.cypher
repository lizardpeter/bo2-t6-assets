id":"urn:ure:t6:occ:callsite:current-client:007d18c6","call_va":"0x007D18C6","target_va":"0x005608F0","section":".text","bytes":"e825f0d8ff","caller_id":"urn:ure:t6:occ:function:current-client:007d1240","target_id":"urn:ure:t6:occ:function:current-client:005608f0"},{"id":"urn:ure:t6:occ:callsite:current-client:007d18cc","call_va":"0x007D18CC","target_va":"0x00A7301A","section":".text","bytes":"e849172a00","caller_id":"urn:ure:t6:occ:function:current-client:007d1240","target_id":"urn:ure:t6:occ:function:current-client:00a7301a"},{"id":"urn:ure:t6:occ:callsite:current-client:007d18d7","call_va":"0x007D18D7","target_va":"0x005608F0","section":".text","bytes":"e814f0d8ff","caller_id":"urn:ure:t6:occ:function:current-client:007d1240","target_id":"urn:ure:t6:occ:function:current-client:005608f0"},{"id":"urn:ure:t6:occ:callsite:current-client:007d18dd","call_va":"0x007D18DD","target_va":"0x00A749C5","section":".text","bytes":"e8e3302a00","caller_id":"urn:ure:t6:occ:function:current-client:007d1240","target_id":"urn:ure:t6:occ:function:current-client:00a749c5"},{"id":"urn:ure:t6:occ:callsite:current-client:007d18eb","call_va":"0x007D18EB","target_va":"0x005608F0","section":".text","bytes":"e800f0d8ff","caller_id":"urn:ure:t6:occ:function:current-client:007d1240","target_id":"urn:ure:t6:occ:function:current-client:005608f0"},{"id":"urn:ure:t6:occ:callsite:current-client:007d18f1","call_va":"0x007D18F1","target_va":"0x00A749C5","section":".text","bytes":"e8cf302a00","caller_id":"urn:ure:t6:occ:function:current-client:007d1240","target_id":"urn:ure:t6:occ:function:current-client:00a749c5"}] AS rows
