nt:007893f1",va:"0x007893F1",section:".text",length:5,text:"|$4;y",truncated:false,sha256:"dd1030fad21da8f1e61ca0ee9ec9fa35a6d316e18b2265bbdd6a5d5f73321f39"},{id:"urn:ure:t6:occ:string:current-client:0078940b",va:"0x0078940B",section:".text",length:4,text:"T;BD",truncated:false,sha256:"1a9af70e5c811ec314b3a0ddcb0e1c88a8faa9c9d1f137e9d28420f1702bc73f"},{id:"urn:ure:t6:occ:string:current-client:0078941f",va:"0x0078941F",section:".text",length:4,text:"]_^[",truncated:false,sha256:"8741a57a96236e7956627c14272af6022e6a5448568849f5a88e74b4a1d9d9d6"},{id:"urn:ure:t6:occ:string:current-client:00789435",va:"0x00789435",section:".text",length:6,text:"\\$4UVW",truncated:false,sha256:"f54ef5c141bdcf8b706bb7dbee528bc61a586756582a28f94c63d60eb37c74fb"},{id:"urn:ure:t6:occ:string:current-client:00789444",va:"0x00789444",section:".text",length:4,text:"|$ 9",truncated:false,sha256:"0a9afc2dc6704e41960d8c0d679ca2b41a4cf7e4bed6dbdae4d0dc964dd9da39"}] AS rows
UNWIND rows AS row
MERGE (n:KGNode {id:row.id})
ON CREATE SET n._mechanical_inventory_new=true
SET n.kind='core:Occurrence', n.occurrence_type='string-literal', n.namespace='t6', n.build_id=b.id, n.artifact_id=a.id,
    n.address_space='va', n.address_start=row.va, n.section_name=row.section, n.length=row.length,
    n.text=row.text, n.truncated=row.truncated, n.content_sha256=row.sha256,
    n.producer='t6-current-client-whole-image-mechanical-inventory-v1'
WITH b,a,n,coalesce(n._mechanical_inventory_new,false) AS is_new
FOREACH (_ IN CASE WHEN is_new THEN [1] ELSE [] END |
  CREATE (b)-[:HAS_OCCURRENCE]->(n)
  CREATE (n)-[:DEFINED_IN]->(a)
)
REMOVE n._mechanical_inventory_new
