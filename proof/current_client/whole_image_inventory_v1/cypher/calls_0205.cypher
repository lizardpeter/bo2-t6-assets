id":"urn:ure:t6:occ:callsite:current-client:005f5f0c","call_va":"0x005F5F0C","target_va":"0x006033D0","section":".text","bytes":"e8bfd40000","caller_id":"urn:ure:t6:occ:function:current-client:005f5cb0","target_id":"urn:ure:t6:occ:function:current-client:006033d0"},{"id":"urn:ure:t6:occ:callsite:current-client:005f5f16","call_va":"0x005F5F16","target_va":"0x006033D0","section":".text","bytes":"e8b5d40000","caller_id":"urn:ure:t6:occ:function:current-client:005f5cb0","target_id":"urn:ure:t6:occ:function:current-client:006033d0"},{"id":"urn:ure:t6:occ:callsite:current-client:005f5f20","call_va":"0x005F5F20","target_va":"0x006033D0","section":".text","bytes":"e8abd40000","caller_id":"urn:ure:t6:occ:function:current-client:005f5cb0","target_id":"urn:ure:t6:occ:function:current-client:006033d0"},{"id":"urn:ure:t6:occ:callsite:current-client:005f5f2a","call_va":"0x005F5F2A","target_va":"0x006033D0","section":".text","bytes":"e8a1d40000","caller_id":"urn:ure:t6:occ:function:current-client:005f5cb0","target_id":"urn:ure:t6:occ:function:current-client:006033d0"},{"id":"urn:ure:t6:occ:callsite:current-client:005f5f34","call_va":"0x005F5F34","target_va":"0x006033D0","section":".text","bytes":"e897d40000","caller_id":"urn:ure:t6:occ:function:current-client:005f5cb0","target_id":"urn:ure:t6:occ:function:current-client:006033d0"},{"id":"urn:ure:t6:occ:callsite:current-client:005f5f41","call_va":"0x005F5F41","target_va":"0x006033D0","section":".text","bytes":"e88ad40000","caller_id":"urn:ure:t6:occ:function:current-client:005f5cb0","target_id":"urn:ure:t6:occ:function:current-client:006033d0"}] AS rows
