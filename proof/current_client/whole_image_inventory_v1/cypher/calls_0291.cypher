id":"urn:ure:t6:occ:callsite:current-client:006d384c","call_va":"0x006D384C","target_va":"0x00617600","section":".text","bytes":"e8af3df4ff","caller_id":"urn:ure:t6:occ:function:current-client:006d3650","target_id":"urn:ure:t6:occ:function:current-client:00617600"},{"id":"urn:ure:t6:occ:callsite:current-client:006d3871","call_va":"0x006D3871","target_va":"0x005F24E0","section":".text","bytes":"e86aecf1ff","caller_id":"urn:ure:t6:occ:function:current-client:006d3650","target_id":"urn:ure:t6:occ:function:current-client:005f24e0"},{"id":"urn:ure:t6:occ:callsite:current-client:006d388c","call_va":"0x006D388C","target_va":"0x004E0170","section":".text","bytes":"e8dfc8e0ff","caller_id":"urn:ure:t6:occ:function:current-client:006d3650","target_id":"urn:ure:t6:occ:function:current-client:004e0170"},{"id":"urn:ure:t6:occ:callsite:current-client:006d38a4","call_va":"0x006D38A4","target_va":"0x004E0170","section":".text","bytes":"e8c7c8e0ff","caller_id":"urn:ure:t6:occ:function:current-client:006d3650","target_id":"urn:ure:t6:occ:function:current-client:004e0170"},{"id":"urn:ure:t6:occ:callsite:current-client:006d38e4","call_va":"0x006D38E4","target_va":"0x004445C0","section":".text","bytes":"e8d70cd7ff","caller_id":"urn:ure:t6:occ:function:current-client:006d3650","target_id":"urn:ure:t6:occ:function:current-client:004445c0"},{"id":"urn:ure:t6:occ:callsite:current-client:006d3924","call_va":"0x006D3924","target_va":"0x004445C0","section":".text","bytes":"e8970cd7ff","caller_id":"urn:ure:t6:occ:function:current-client:006d3650","target_id":"urn:ure:t6:occ:function:current-client:004445c0"}] AS rows
