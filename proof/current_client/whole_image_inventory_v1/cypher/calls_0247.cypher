id":"urn:ure:t6:occ:callsite:current-client:00665bc5","call_va":"0x00665BC5","target_va":"0x00918590","section":".text","bytes":"e8c6292b00","caller_id":"urn:ure:t6:occ:function:current-client:00665bc0","target_id":"urn:ure:t6:occ:function:current-client:00918590"},{"id":"urn:ure:t6:occ:callsite:current-client:00665bce","call_va":"0x00665BCE","target_va":"0x00918E20","section":".text","bytes":"e84d322b00","caller_id":"urn:ure:t6:occ:function:current-client:00665bc0","target_id":"urn:ure:t6:occ:function:current-client:00918e20"},{"id":"urn:ure:t6:occ:callsite:current-client:00665be9","call_va":"0x00665BE9","target_va":"0x0057AFF0","section":".text","bytes":"e80254f1ff","caller_id":"urn:ure:t6:occ:function:current-client:00665be0","target_id":"urn:ure:t6:occ:function:current-client:0057aff0"},{"id":"urn:ure:t6:occ:callsite:current-client:00665bf6","call_va":"0x00665BF6","target_va":"0x0057AFF0","section":".text","bytes":"e8f553f1ff","caller_id":"urn:ure:t6:occ:function:current-client:00665be0","target_id":"urn:ure:t6:occ:function:current-client:0057aff0"},{"id":"urn:ure:t6:occ:callsite:current-client:00665c03","call_va":"0x00665C03","target_va":"0x0057AFF0","section":".text","bytes":"e8e853f1ff","caller_id":"urn:ure:t6:occ:function:current-client:00665be0","target_id":"urn:ure:t6:occ:function:current-client:0057aff0"},{"id":"urn:ure:t6:occ:callsite:current-client:00665c10","call_va":"0x00665C10","target_va":"0x0057AFF0","section":".text","bytes":"e8db53f1ff","caller_id":"urn:ure:t6:occ:function:current-client:00665be0","target_id":"urn:ure:t6:occ:function:current-client:0057aff0"}] AS rows
