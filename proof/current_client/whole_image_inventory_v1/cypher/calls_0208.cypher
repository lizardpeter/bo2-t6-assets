id":"urn:ure:t6:occ:callsite:current-client:005fd882","call_va":"0x005FD882","target_va":"0x005535E0","section":".text","bytes":"e8595df5ff","caller_id":"urn:ure:t6:occ:function:current-client:005fd770","target_id":"urn:ure:t6:occ:function:current-client:005535e0"},{"id":"urn:ure:t6:occ:callsite:current-client:005fd88d","call_va":"0x005FD88D","target_va":"0x0044D240","section":".text","bytes":"e8aef9e4ff","caller_id":"urn:ure:t6:occ:function:current-client:005fd770","target_id":"urn:ure:t6:occ:function:current-client:0044d240"},{"id":"urn:ure:t6:occ:callsite:current-client:005fd8b4","call_va":"0x005FD8B4","target_va":"0x004D8EA0","section":".text","bytes":"e8e7b5edff","caller_id":"urn:ure:t6:occ:function:current-client:005fd770","target_id":"urn:ure:t6:occ:function:current-client:004d8ea0"},{"id":"urn:ure:t6:occ:callsite:current-client:005fd8e7","call_va":"0x005FD8E7","target_va":"0x004A4F50","section":".text","bytes":"e86476eaff","caller_id":"urn:ure:t6:occ:function:current-client:005fd770","target_id":"urn:ure:t6:occ:function:current-client:004a4f50"},{"id":"urn:ure:t6:occ:callsite:current-client:005fd8f5","call_va":"0x005FD8F5","target_va":"0x009B1BE0","section":".text","bytes":"e8e6423b00","caller_id":"urn:ure:t6:occ:function:current-client:005fd770","target_id":"urn:ure:t6:occ:function:current-client:009b1be0"},{"id":"urn:ure:t6:occ:callsite:current-client:005fd916","call_va":"0x005FD916","target_va":"0x005E24C0","section":".text","bytes":"e8a54bfeff","caller_id":"urn:ure:t6:occ:function:current-client:005fd910","target_id":"urn:ure:t6:occ:function:current-client:005e24c0"}] AS rows
