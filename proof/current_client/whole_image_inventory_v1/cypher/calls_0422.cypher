id":"urn:ure:t6:occ:callsite:current-client:0084a0b2","call_va":"0x0084A0B2","target_va":"0x0048F250","section":".text","bytes":"e89951c4ff","caller_id":"urn:ure:t6:occ:function:current-client:0084a050","target_id":"urn:ure:t6:occ:function:current-client:0048f250"},{"id":"urn:ure:t6:occ:callsite:current-client:0084a0bd","call_va":"0x0084A0BD","target_va":"0x0045BAF0","section":".text","bytes":"e82e1ac1ff","caller_id":"urn:ure:t6:occ:function:current-client:0084a050","target_id":"urn:ure:t6:occ:function:current-client:0045baf0"},{"id":"urn:ure:t6:occ:callsite:current-client:0084a0ce","call_va":"0x0084A0CE","target_va":"0x0041B610","section":".text","bytes":"e83d15bdff","caller_id":"urn:ure:t6:occ:function:current-client:0084a050","target_id":"urn:ure:t6:occ:function:current-client:0041b610"},{"id":"urn:ure:t6:occ:callsite:current-client:0084a0e4","call_va":"0x0084A0E4","target_va":"0x00415A30","section":".text","bytes":"e847b9bcff","caller_id":"urn:ure:t6:occ:function:current-client:0084a050","target_id":"urn:ure:t6:occ:function:current-client:00415a30"},{"id":"urn:ure:t6:occ:callsite:current-client:0084a0ee","call_va":"0x0084A0EE","target_va":"0x00403150","section":".text","bytes":"e85d90bbff","caller_id":"urn:ure:t6:occ:function:current-client:0084a050","target_id":"urn:ure:t6:occ:function:current-client:00403150"},{"id":"urn:ure:t6:occ:callsite:current-client:0084a0f6","call_va":"0x0084A0F6","target_va":"0x0057AFF0","section":".text","bytes":"e8f50ed3ff","caller_id":"urn:ure:t6:occ:function:current-client:0084a050","target_id":"urn:ure:t6:occ:function:current-client:0057aff0"}] AS rows
