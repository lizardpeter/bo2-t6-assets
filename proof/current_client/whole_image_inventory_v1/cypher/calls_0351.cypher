id":"urn:ure:t6:occ:callsite:current-client:007b44c9","call_va":"0x007B44C9","target_va":"0x0041F490","section":".text","bytes":"e8c2afc6ff","caller_id":"urn:ure:t6:occ:function:current-client:007b1f60","target_id":"urn:ure:t6:occ:function:current-client:0041f490"},{"id":"urn:ure:t6:occ:callsite:current-client:007b4532","call_va":"0x007B4532","target_va":"0x00499E10","section":".text","bytes":"e8d958ceff","caller_id":"urn:ure:t6:occ:function:current-client:007b1f60","target_id":"urn:ure:t6:occ:function:current-client:00499e10"},{"id":"urn:ure:t6:occ:callsite:current-client:007b453c","call_va":"0x007B453C","target_va":"0x0045A8E0","section":".text","bytes":"e89f63caff","caller_id":"urn:ure:t6:occ:function:current-client:007b1f60","target_id":"urn:ure:t6:occ:function:current-client:0045a8e0"},{"id":"urn:ure:t6:occ:callsite:current-client:007b455d","call_va":"0x007B455D","target_va":"0x0041F490","section":".text","bytes":"e82eafc6ff","caller_id":"urn:ure:t6:occ:function:current-client:007b1f60","target_id":"urn:ure:t6:occ:function:current-client:0041f490"},{"id":"urn:ure:t6:occ:callsite:current-client:007b45c3","call_va":"0x007B45C3","target_va":"0x00499E10","section":".text","bytes":"e84858ceff","caller_id":"urn:ure:t6:occ:function:current-client:007b1f60","target_id":"urn:ure:t6:occ:function:current-client:00499e10"},{"id":"urn:ure:t6:occ:callsite:current-client:007b45cd","call_va":"0x007B45CD","target_va":"0x0045A8E0","section":".text","bytes":"e80e63caff","caller_id":"urn:ure:t6:occ:function:current-client:007b1f60","target_id":"urn:ure:t6:occ:function:current-client:0045a8e0"}] AS rows
