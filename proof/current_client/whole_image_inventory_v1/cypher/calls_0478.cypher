id":"urn:ure:t6:occ:callsite:current-client:008c4aa1","call_va":"0x008C4AA1","target_va":"0x00A7301A","section":".text","bytes":"e874e51a00","caller_id":"urn:ure:t6:occ:function:current-client:008c46f0","target_id":"urn:ure:t6:occ:function:current-client:00a7301a"},{"id":"urn:ure:t6:occ:callsite:current-client:008c4bc3","call_va":"0x008C4BC3","target_va":"0x00709870","section":".text","bytes":"e8a84ce4ff","caller_id":"urn:ure:t6:occ:function:current-client:008c4bb0","target_id":"urn:ure:t6:occ:function:current-client:00709870"},{"id":"urn:ure:t6:occ:callsite:current-client:008c4bcf","call_va":"0x008C4BCF","target_va":"0x00709870","section":".text","bytes":"e89c4ce4ff","caller_id":"urn:ure:t6:occ:function:current-client:008c4bb0","target_id":"urn:ure:t6:occ:function:current-client:00709870"},{"id":"urn:ure:t6:occ:callsite:current-client:008c4be5","call_va":"0x008C4BE5","target_va":"0x00A749C5","section":".text","bytes":"e8dbfd1a00","caller_id":"urn:ure:t6:occ:function:current-client:008c4bb0","target_id":"urn:ure:t6:occ:function:current-client:00a749c5"},{"id":"urn:ure:t6:occ:callsite:current-client:008c4bef","call_va":"0x008C4BEF","target_va":"0x00A7301A","section":".text","bytes":"e826e41a00","caller_id":"urn:ure:t6:occ:function:current-client:008c4bb0","target_id":"urn:ure:t6:occ:function:current-client:00a7301a"},{"id":"urn:ure:t6:occ:callsite:current-client:008c4c37","call_va":"0x008C4C37","target_va":"0x00A749C5","section":".text","bytes":"e889fd1a00","caller_id":"urn:ure:t6:occ:function:current-client:008c4bb0","target_id":"urn:ure:t6:occ:function:current-client:00a749c5"}] AS rows
UNWIND rows AS row
MATCH (target:KGNode {id:row.target_id})
MERGE (c:KGNode {id:row.id})
SET c.kind='core:Occurrence', c.occurrence_type='direct-callsite', c.namespace='t6', c.build_id=b.id, c.artifact_id=a.id,
