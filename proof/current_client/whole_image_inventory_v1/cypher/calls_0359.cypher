id":"urn:ure:t6:occ:callsite:current-client:007c38b4","call_va":"0x007C38B4","target_va":"0x00624240","section":".text","bytes":"e88709e6ff","caller_id":"urn:ure:t6:occ:function:current-client:007c35e0","target_id":"urn:ure:t6:occ:function:current-client:00624240"},{"id":"urn:ure:t6:occ:callsite:current-client:007c38ce","call_va":"0x007C38CE","target_va":"0x00632C60","section":".text","bytes":"e88df3e6ff","caller_id":"urn:ure:t6:occ:function:current-client:007c35e0","target_id":"urn:ure:t6:occ:function:current-client:00632c60"},{"id":"urn:ure:t6:occ:callsite:current-client:007c38e5","call_va":"0x007C38E5","target_va":"0x00632C60","section":".text","bytes":"e876f3e6ff","caller_id":"urn:ure:t6:occ:function:current-client:007c35e0","target_id":"urn:ure:t6:occ:function:current-client:00632c60"},{"id":"urn:ure:t6:occ:callsite:current-client:007c38f8","call_va":"0x007C38F8","target_va":"0x00632C60","section":".text","bytes":"e863f3e6ff","caller_id":"urn:ure:t6:occ:function:current-client:007c35e0","target_id":"urn:ure:t6:occ:function:current-client:00632c60"},{"id":"urn:ure:t6:occ:callsite:current-client:007c3915","call_va":"0x007C3915","target_va":"0x0045D840","section":".text","bytes":"e8269fc9ff","caller_id":"urn:ure:t6:occ:function:current-client:007c3910","target_id":"urn:ure:t6:occ:function:current-client:0045d840"},{"id":"urn:ure:t6:occ:callsite:current-client:007c3930","call_va":"0x007C3930","target_va":"0x00593820","section":".text","bytes":"e8ebfedcff","caller_id":"urn:ure:t6:occ:function:current-client:007c3910","target_id":"urn:ure:t6:occ:function:current-client:00593820"}] AS rows
