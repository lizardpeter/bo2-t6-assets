id":"urn:ure:t6:occ:callsite:current-client:005c82f8","call_va":"0x005C82F8","target_va":"0x00461760","section":".text","bytes":"e86394e9ff","caller_id":"urn:ure:t6:occ:function:current-client:005c81e0","target_id":"urn:ure:t6:occ:function:current-client:00461760"},{"id":"urn:ure:t6:occ:callsite:current-client:005c8308","call_va":"0x005C8308","target_va":"0x00461760","section":".text","bytes":"e85394e9ff","caller_id":"urn:ure:t6:occ:function:current-client:005c81e0","target_id":"urn:ure:t6:occ:function:current-client:00461760"},{"id":"urn:ure:t6:occ:callsite:current-client:005c8318","call_va":"0x005C8318","target_va":"0x00461760","section":".text","bytes":"e84394e9ff","caller_id":"urn:ure:t6:occ:function:current-client:005c81e0","target_id":"urn:ure:t6:occ:function:current-client:00461760"},{"id":"urn:ure:t6:occ:callsite:current-client:005c8333","call_va":"0x005C8333","target_va":"0x0049C6B0","section":".text","bytes":"e87843edff","caller_id":"urn:ure:t6:occ:function:current-client:005c81e0","target_id":"urn:ure:t6:occ:function:current-client:0049c6b0"},{"id":"urn:ure:t6:occ:callsite:current-client:005c8345","call_va":"0x005C8345","target_va":"0x00425E80","section":".text","bytes":"e836dbe5ff","caller_id":"urn:ure:t6:occ:function:current-client:005c81e0","target_id":"urn:ure:t6:occ:function:current-client:00425e80"},{"id":"urn:ure:t6:occ:callsite:current-client:005c834b","call_va":"0x005C834B","target_va":"0x00585EB0","section":".text","bytes":"e860dbfbff","caller_id":"urn:ure:t6:occ:function:current-client:005c81e0","target_id":"urn:ure:t6:occ:function:current-client:00585eb0"}] AS rows
