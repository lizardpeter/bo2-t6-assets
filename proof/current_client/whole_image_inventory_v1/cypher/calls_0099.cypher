id":"urn:ure:t6:occ:callsite:current-client:004f5c3c","call_va":"0x004F5C3C","target_va":"0x00551B00","section":".text","bytes":"e8bfbe0500","caller_id":"urn:ure:t6:occ:function:current-client:004f56d0","target_id":"urn:ure:t6:occ:function:current-client:00551b00"},{"id":"urn:ure:t6:occ:callsite:current-client:004f5c53","call_va":"0x004F5C53","target_va":"0x00424F00","section":".text","bytes":"e8a8f2f2ff","caller_id":"urn:ure:t6:occ:function:current-client:004f56d0","target_id":"urn:ure:t6:occ:function:current-client:00424f00"},{"id":"urn:ure:t6:occ:callsite:current-client:004f5c6d","call_va":"0x004F5C6D","target_va":"0x004C0830","section":".text","bytes":"e8beabfcff","caller_id":"urn:ure:t6:occ:function:current-client:004f56d0","target_id":"urn:ure:t6:occ:function:current-client:004c0830"},{"id":"urn:ure:t6:occ:callsite:current-client:004f5cb4","call_va":"0x004F5CB4","target_va":"0x005465E0","section":".text","bytes":"e827090500","caller_id":"urn:ure:t6:occ:function:current-client:004f56d0","target_id":"urn:ure:t6:occ:function:current-client:005465e0"},{"id":"urn:ure:t6:occ:callsite:current-client:004f5cd7","call_va":"0x004F5CD7","target_va":"0x00701590","section":".text","bytes":"e8b4b82000","caller_id":"urn:ure:t6:occ:function:current-client:004f5cd0","target_id":"urn:ure:t6:occ:function:current-client:00701590"},{"id":"urn:ure:t6:occ:callsite:current-client:004f5ced","call_va":"0x004F5CED","target_va":"0x004B7710","section":".text","bytes":"e81e1afcff","caller_id":"urn:ure:t6:occ:function:current-client:004f5cd0","target_id":"urn:ure:t6:occ:function:current-client:004b7710"}] AS rows
