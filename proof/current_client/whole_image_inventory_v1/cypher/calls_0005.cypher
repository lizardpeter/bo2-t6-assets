  CREATE (c)-[:DEFINED_IN]->(a)
  CREATE (c)-[:CALLS_TARGET]->(target)
)
FOREACH (_ IN CASE WHEN is_new AND caller IS NOT NULL THEN [1] ELSE [] END |
  CREATE (caller)-[:HAS_CALLSITE]->(c)
)
REMOVE c._mechanical_inventory_new
