id":"urn:ure:t6:occ:callsite:current-client:008bffef","call_va":"0x008BFFEF","target_va":"0x004F1E10","section":".text","bytes":"e81c1ec3ff","caller_id":"urn:ure:t6:occ:function:current-client:008bfc10","target_id":"urn:ure:t6:occ:function:current-client:004f1e10"},{"id":"urn:ure:t6:occ:callsite:current-client:008c0060","call_va":"0x008C0060","target_va":"0x00709870","section":".text","bytes":"e80b98e4ff","caller_id":"urn:ure:t6:occ:function:current-client:008c0050","target_id":"urn:ure:t6:occ:function:current-client:00709870"},{"id":"urn:ure:t6:occ:callsite:current-client:008c0090","call_va":"0x008C0090","target_va":"0x00A7301A","section":".text","bytes":"e8852f1b00","caller_id":"urn:ure:t6:occ:function:current-client:008c0050","target_id":"urn:ure:t6:occ:function:current-client:00a7301a"},{"id":"urn:ure:t6:occ:callsite:current-client:008c009e","call_va":"0x008C009E","target_va":"0x00701590","section":".text","bytes":"e8ed14e4ff","caller_id":"urn:ure:t6:occ:function:current-client:008c0050","target_id":"urn:ure:t6:occ:function:current-client:00701590"},{"id":"urn:ure:t6:occ:callsite:current-client:008c00a7","call_va":"0x008C00A7","target_va":"0x00490FE0","section":".text","bytes":"e8340fbdff","caller_id":"urn:ure:t6:occ:function:current-client:008c0050","target_id":"urn:ure:t6:occ:function:current-client:00490fe0"},{"id":"urn:ure:t6:occ:callsite:current-client:008c0110","call_va":"0x008C0110","target_va":"0x00709870","section":".text","bytes":"e85b97e4ff","caller_id":"urn:ure:t6:occ:function:current-client:008c0050","target_id":"urn:ure:t6:occ:function:current-client:00709870"}] AS rows
