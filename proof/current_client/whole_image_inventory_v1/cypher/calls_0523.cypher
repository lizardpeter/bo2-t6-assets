id":"urn:ure:t6:occ:callsite:current-client:009424b9","call_va":"0x009424B9","target_va":"0x0048F3B0","section":".text","bytes":"e8f2ceb4ff","caller_id":"urn:ure:t6:occ:function:current-client:00942460","target_id":"urn:ure:t6:occ:function:current-client:0048f3b0"},{"id":"urn:ure:t6:occ:callsite:current-client:00942533","call_va":"0x00942533","target_va":"0x005225F0","section":".text","bytes":"e8b800beff","caller_id":"urn:ure:t6:occ:function:current-client:00942520","target_id":"urn:ure:t6:occ:function:current-client:005225f0"},{"id":"urn:ure:t6:occ:callsite:current-client:0094256d","call_va":"0x0094256D","target_va":"0x005225F0","section":".text","bytes":"e87e00beff","caller_id":"urn:ure:t6:occ:function:current-client:00942520","target_id":"urn:ure:t6:occ:function:current-client:005225f0"},{"id":"urn:ure:t6:occ:callsite:current-client:009425af","call_va":"0x009425AF","target_va":"0x005225F0","section":".text","bytes":"e83c00beff","caller_id":"urn:ure:t6:occ:function:current-client:00942520","target_id":"urn:ure:t6:occ:function:current-client:005225f0"},{"id":"urn:ure:t6:occ:callsite:current-client:00942610","call_va":"0x00942610","target_va":"0x009423E0","section":".text","bytes":"e8cbfdffff","caller_id":"urn:ure:t6:occ:function:current-client:00942600","target_id":"urn:ure:t6:occ:function:current-client:009423e0"},{"id":"urn:ure:t6:occ:callsite:current-client:00942626","call_va":"0x00942626","target_va":"0x0048F3B0","section":".text","bytes":"e885cdb4ff","caller_id":"urn:ure:t6:occ:function:current-client:00942600","target_id":"urn:ure:t6:occ:function:current-client:0048f3b0"}] AS rows
