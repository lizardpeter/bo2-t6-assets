id":"urn:ure:t6:occ:callsite:current-client:005a1f86","call_va":"0x005A1F86","target_va":"0x005EFBA0","section":".text","bytes":"e815dc0400","caller_id":"urn:ure:t6:occ:function:current-client:005a1dc0","target_id":"urn:ure:t6:occ:function:current-client:005efba0"},{"id":"urn:ure:t6:occ:callsite:current-client:005a1fac","call_va":"0x005A1FAC","target_va":"0x005EFBA0","section":".text","bytes":"e8efdb0400","caller_id":"urn:ure:t6:occ:function:current-client:005a1dc0","target_id":"urn:ure:t6:occ:function:current-client:005efba0"},{"id":"urn:ure:t6:occ:callsite:current-client:005a1fd7","call_va":"0x005A1FD7","target_va":"0x00546400","section":".text","bytes":"e82444faff","caller_id":"urn:ure:t6:occ:function:current-client:005a1dc0","target_id":"urn:ure:t6:occ:function:current-client:00546400"},{"id":"urn:ure:t6:occ:callsite:current-client:005a1ff7","call_va":"0x005A1FF7","target_va":"0x00546400","section":".text","bytes":"e80444faff","caller_id":"urn:ure:t6:occ:function:current-client:005a1dc0","target_id":"urn:ure:t6:occ:function:current-client:00546400"},{"id":"urn:ure:t6:occ:callsite:current-client:005a2015","call_va":"0x005A2015","target_va":"0x00546400","section":".text","bytes":"e8e643faff","caller_id":"urn:ure:t6:occ:function:current-client:005a1dc0","target_id":"urn:ure:t6:occ:function:current-client:00546400"},{"id":"urn:ure:t6:occ:callsite:current-client:005a2054","call_va":"0x005A2054","target_va":"0x00546400","section":".text","bytes":"e8a743faff","caller_id":"urn:ure:t6:occ:function:current-client:005a1dc0","target_id":"urn:ure:t6:occ:function:current-client:00546400"}] AS rows
