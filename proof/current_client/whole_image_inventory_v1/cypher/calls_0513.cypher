id":"urn:ure:t6:occ:callsite:current-client:00928b8f","call_va":"0x00928B8F","target_va":"0x00494940","section":".text","bytes":"e8acbdb6ff","caller_id":"urn:ure:t6:occ:function:current-client:00928a90","target_id":"urn:ure:t6:occ:function:current-client:00494940"},{"id":"urn:ure:t6:occ:callsite:current-client:00928b98","call_va":"0x00928B98","target_va":"0x00560040","section":".text","bytes":"e8a374c3ff","caller_id":"urn:ure:t6:occ:function:current-client:00928a90","target_id":"urn:ure:t6:occ:function:current-client:00560040"},{"id":"urn:ure:t6:occ:callsite:current-client:00928ba1","call_va":"0x00928BA1","target_va":"0x0063D6A0","section":".text","bytes":"e8fa4ad1ff","caller_id":"urn:ure:t6:occ:function:current-client:00928a90","target_id":"urn:ure:t6:occ:function:current-client:0063d6a0"},{"id":"urn:ure:t6:occ:callsite:current-client:00928bac","call_va":"0x00928BAC","target_va":"0x0062FDB0","section":".text","bytes":"e8ff71d0ff","caller_id":"urn:ure:t6:occ:function:current-client:00928a90","target_id":"urn:ure:t6:occ:function:current-client:0062fdb0"},{"id":"urn:ure:t6:occ:callsite:current-client:00928bc7","call_va":"0x00928BC7","target_va":"0x005EFBA0","section":".text","bytes":"e8d46fccff","caller_id":"urn:ure:t6:occ:function:current-client:00928bc0","target_id":"urn:ure:t6:occ:function:current-client:005efba0"},{"id":"urn:ure:t6:occ:callsite:current-client:00928be2","call_va":"0x00928BE2","target_va":"0x005EFBA0","section":".text","bytes":"e8b96fccff","caller_id":"urn:ure:t6:occ:function:current-client:00928bc0","target_id":"urn:ure:t6:occ:function:current-client:005efba0"}] AS rows
