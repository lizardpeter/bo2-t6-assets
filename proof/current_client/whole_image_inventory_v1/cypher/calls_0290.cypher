id":"urn:ure:t6:occ:callsite:current-client:006d081e","call_va":"0x006D081E","target_va":"0x004CEF70","section":".text","bytes":"e84de7dfff","caller_id":"urn:ure:t6:occ:function:current-client:006d07a0","target_id":"urn:ure:t6:occ:function:current-client:004cef70"},{"id":"urn:ure:t6:occ:callsite:current-client:006d083a","call_va":"0x006D083A","target_va":"0x004645D0","section":".text","bytes":"e8913dd9ff","caller_id":"urn:ure:t6:occ:function:current-client:006d0830","target_id":"urn:ure:t6:occ:function:current-client:004645d0"},{"id":"urn:ure:t6:occ:callsite:current-client:006d0878","call_va":"0x006D0878","target_va":"0x004645D0","section":".text","bytes":"e8533dd9ff","caller_id":"urn:ure:t6:occ:function:current-client:006d0830","target_id":"urn:ure:t6:occ:function:current-client:004645d0"},{"id":"urn:ure:t6:occ:callsite:current-client:006d08b1","call_va":"0x006D08B1","target_va":"0x004645D0","section":".text","bytes":"e81a3dd9ff","caller_id":"urn:ure:t6:occ:function:current-client:006d0830","target_id":"urn:ure:t6:occ:function:current-client:004645d0"},{"id":"urn:ure:t6:occ:callsite:current-client:006d08ea","call_va":"0x006D08EA","target_va":"0x004645D0","section":".text","bytes":"e8e13cd9ff","caller_id":"urn:ure:t6:occ:function:current-client:006d0830","target_id":"urn:ure:t6:occ:function:current-client:004645d0"},{"id":"urn:ure:t6:occ:callsite:current-client:006d0924","call_va":"0x006D0924","target_va":"0x0044DFC0","section":".text","bytes":"e897d6d7ff","caller_id":"urn:ure:t6:occ:function:current-client:006d0830","target_id":"urn:ure:t6:occ:function:current-client:0044dfc0"}] AS rows
