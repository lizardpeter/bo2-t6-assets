id":"urn:ure:t6:occ:callsite:current-client:0098f85d","call_va":"0x0098F85D","target_va":"0x004B1130","section":".text","bytes":"e8ce18b2ff","caller_id":"urn:ure:t6:occ:function:current-client:0098eb50","target_id":"urn:ure:t6:occ:function:current-client:004b1130"},{"id":"urn:ure:t6:occ:callsite:current-client:0098f866","call_va":"0x0098F866","target_va":"0x00663BB0","section":".text","bytes":"e84543cdff","caller_id":"urn:ure:t6:occ:function:current-client:0098eb50","target_id":"urn:ure:t6:occ:function:current-client:00663bb0"},{"id":"urn:ure:t6:occ:callsite:current-client:0098f86f","call_va":"0x0098F86F","target_va":"0x00620380","section":".text","bytes":"e80c0bc9ff","caller_id":"urn:ure:t6:occ:function:current-client:0098eb50","target_id":"urn:ure:t6:occ:function:current-client:00620380"},{"id":"urn:ure:t6:occ:callsite:current-client:0098f87d","call_va":"0x0098F87D","target_va":"0x0067D6C0","section":".text","bytes":"e83edeceff","caller_id":"urn:ure:t6:occ:function:current-client:0098eb50","target_id":"urn:ure:t6:occ:function:current-client:0067d6c0"},{"id":"urn:ure:t6:occ:callsite:current-client:0098f884","call_va":"0x0098F884","target_va":"0x005A0010","section":".text","bytes":"e88707c1ff","caller_id":"urn:ure:t6:occ:function:current-client:0098eb50","target_id":"urn:ure:t6:occ:function:current-client:005a0010"},{"id":"urn:ure:t6:occ:callsite:current-client:0098f88a","call_va":"0x0098F88A","target_va":"0x005623F0","section":".text","bytes":"e8612bbdff","caller_id":"urn:ure:t6:occ:function:current-client:0098eb50","target_id":"urn:ure:t6:occ:function:current-client:005623f0"}] AS rows
