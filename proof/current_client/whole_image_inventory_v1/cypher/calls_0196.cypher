id":"urn:ure:t6:occ:callsite:current-client:005deb45","call_va":"0x005DEB45","target_va":"0x005F7BB0","section":".text","bytes":"e866900100","caller_id":"urn:ure:t6:occ:function:current-client:005de4a0","target_id":"urn:ure:t6:occ:function:current-client:005f7bb0"},{"id":"urn:ure:t6:occ:callsite:current-client:005deb51","call_va":"0x005DEB51","target_va":"0x005F7BB0","section":".text","bytes":"e85a900100","caller_id":"urn:ure:t6:occ:function:current-client:005de4a0","target_id":"urn:ure:t6:occ:function:current-client:005f7bb0"},{"id":"urn:ure:t6:occ:callsite:current-client:005deb7e","call_va":"0x005DEB7E","target_va":"0x005F7BB0","section":".text","bytes":"e82d900100","caller_id":"urn:ure:t6:occ:function:current-client:005de4a0","target_id":"urn:ure:t6:occ:function:current-client:005f7bb0"},{"id":"urn:ure:t6:occ:callsite:current-client:005deba5","call_va":"0x005DEBA5","target_va":"0x0044DFC0","section":".text","bytes":"e816f4e6ff","caller_id":"urn:ure:t6:occ:function:current-client:005de4a0","target_id":"urn:ure:t6:occ:function:current-client:0044dfc0"},{"id":"urn:ure:t6:occ:callsite:current-client:005debcb","call_va":"0x005DEBCB","target_va":"0x00440E70","section":".text","bytes":"e8a022e6ff","caller_id":"urn:ure:t6:occ:function:current-client:005de4a0","target_id":"urn:ure:t6:occ:function:current-client:00440e70"},{"id":"urn:ure:t6:occ:callsite:current-client:005debda","call_va":"0x005DEBDA","target_va":"0x004BE220","section":".text","bytes":"e841f6edff","caller_id":"urn:ure:t6:occ:function:current-client:005de4a0","target_id":"urn:ure:t6:occ:function:current-client:004be220"}] AS rows
