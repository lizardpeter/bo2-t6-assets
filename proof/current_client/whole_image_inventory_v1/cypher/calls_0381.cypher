id":"urn:ure:t6:occ:callsite:current-client:007f0e00","call_va":"0x007F0E00","target_va":"0x0058E1A0","section":".text","bytes":"e89bd3d9ff","caller_id":"urn:ure:t6:occ:function:current-client:007f0d10","target_id":"urn:ure:t6:occ:function:current-client:0058e1a0"},{"id":"urn:ure:t6:occ:callsite:current-client:007f0e12","call_va":"0x007F0E12","target_va":"0x005EFBA0","section":".text","bytes":"e889eddfff","caller_id":"urn:ure:t6:occ:function:current-client:007f0d10","target_id":"urn:ure:t6:occ:function:current-client:005efba0"},{"id":"urn:ure:t6:occ:callsite:current-client:007f0e38","call_va":"0x007F0E38","target_va":"0x00A7301A","section":".text","bytes":"e8dd212800","caller_id":"urn:ure:t6:occ:function:current-client:007f0d10","target_id":"urn:ure:t6:occ:function:current-client:00a7301a"},{"id":"urn:ure:t6:occ:callsite:current-client:007f0e4d","call_va":"0x007F0E4D","target_va":"0x00705300","section":".text","bytes":"e8ae44f1ff","caller_id":"urn:ure:t6:occ:function:current-client:007f0d10","target_id":"urn:ure:t6:occ:function:current-client:00705300"},{"id":"urn:ure:t6:occ:callsite:current-client:007f0e56","call_va":"0x007F0E56","target_va":"0x004687D0","section":".text","bytes":"e87579c7ff","caller_id":"urn:ure:t6:occ:function:current-client:007f0d10","target_id":"urn:ure:t6:occ:function:current-client:004687d0"},{"id":"urn:ure:t6:occ:callsite:current-client:007f0e62","call_va":"0x007F0E62","target_va":"0x005EFBA0","section":".text","bytes":"e839eddfff","caller_id":"urn:ure:t6:occ:function:current-client:007f0d10","target_id":"urn:ure:t6:occ:function:current-client:005efba0"}] AS rows
