id":"urn:ure:t6:occ:callsite:current-client:00981efb","call_va":"0x00981EFB","target_va":"0x0042E5D0","section":".text","bytes":"e8d0c6aaff","caller_id":"urn:ure:t6:occ:function:current-client:00981ef0","target_id":"urn:ure:t6:occ:function:current-client:0042e5d0"},{"id":"urn:ure:t6:occ:callsite:current-client:00981f47","call_va":"0x00981F47","target_va":"0x0056EBA0","section":".text","bytes":"e854ccbeff","caller_id":"urn:ure:t6:occ:function:current-client:00981ef0","target_id":"urn:ure:t6:occ:function:current-client:0056eba0"},{"id":"urn:ure:t6:occ:callsite:current-client:00981f5d","call_va":"0x00981F5D","target_va":"0x005E5700","section":".text","bytes":"e89e37c6ff","caller_id":"urn:ure:t6:occ:function:current-client:00981ef0","target_id":"urn:ure:t6:occ:function:current-client:005e5700"},{"id":"urn:ure:t6:occ:callsite:current-client:00981f7e","call_va":"0x00981F7E","target_va":"0x005E5700","section":".text","bytes":"e87d37c6ff","caller_id":"urn:ure:t6:occ:function:current-client:00981ef0","target_id":"urn:ure:t6:occ:function:current-client:005e5700"},{"id":"urn:ure:t6:occ:callsite:current-client:00981f9d","call_va":"0x00981F9D","target_va":"0x0068B8B0","section":".text","bytes":"e80e99d0ff","caller_id":"urn:ure:t6:occ:function:current-client:00981f90","target_id":"urn:ure:t6:occ:function:current-client:0068b8b0"},{"id":"urn:ure:t6:occ:callsite:current-client:00981faa","call_va":"0x00981FAA","target_va":"0x004CCB70","section":".text","bytes":"e8c1abb4ff","caller_id":"urn:ure:t6:occ:function:current-client:00981f90","target_id":"urn:ure:t6:occ:function:current-client:004ccb70"}] AS rows
