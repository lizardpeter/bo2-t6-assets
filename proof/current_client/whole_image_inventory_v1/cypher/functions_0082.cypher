0","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:009c16c0","va":"0x009C16C0","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:009c1ae0","va":"0x009C1AE0","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:009c1b90","va":"0x009C1B90","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:009c1d50","va":"0x009C1D50","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:009c1ef0","va":"0x009C1EF0","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:009c37d0","va":"0x009C37D0","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:009c3910","va":"0x009C3910","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:009c39c0","va":"0x009C39C0","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:009c3bc0","va":"0x009C3BC0","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:009c3ec0","va":"0x009C3EC0","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"}] AS rows
UNWIND rows AS row
MERGE (n:KGNode {id:row.id})
ON CREATE SET n.kind='re:FunctionOccurrence', n.namespace='t6', n.build_id=b.id, n.artifact_id=a.id,
    n.display_name='sub_'+substring(row.va,2), n.address_space='va', n.address_start=row.va
SET n.entry_basis=row.basis, n.entry_strongest_basis=row.strongest_basis,
    n.boundary_state=CASE WHEN coalesce(n.boundary_state,'') STARTS WITH 'exact-' THEN n.boundary_state ELSE 'entry-only-mechanical-inventory' END,
    n.producer=CASE WHEN n.producer IS NULL THEN 't6-current-client-whole-image-mechanical-inventory-v1' ELSE n.producer END
MERGE (b)-[:HAS_OCCURRENCE]->(n)
MERGE (n)-[:DEFINED_IN]->(a)
