id":"urn:ure:t6:occ:callsite:current-client:0065c952","call_va":"0x0065C952","target_va":"0x004E0170","section":".text","bytes":"e81938e8ff","caller_id":"urn:ure:t6:occ:function:current-client:0065c2a0","target_id":"urn:ure:t6:occ:function:current-client:004e0170"},{"id":"urn:ure:t6:occ:callsite:current-client:0065c96d","call_va":"0x0065C96D","target_va":"0x004E0170","section":".text","bytes":"e8fe37e8ff","caller_id":"urn:ure:t6:occ:function:current-client:0065c2a0","target_id":"urn:ure:t6:occ:function:current-client:004e0170"},{"id":"urn:ure:t6:occ:callsite:current-client:0065c989","call_va":"0x0065C989","target_va":"0x005F24E0","section":".text","bytes":"e8525bf9ff","caller_id":"urn:ure:t6:occ:function:current-client:0065c2a0","target_id":"urn:ure:t6:occ:function:current-client:005f24e0"},{"id":"urn:ure:t6:occ:callsite:current-client:0065c9a7","call_va":"0x0065C9A7","target_va":"0x004E0170","section":".text","bytes":"e8c437e8ff","caller_id":"urn:ure:t6:occ:function:current-client:0065c2a0","target_id":"urn:ure:t6:occ:function:current-client:004e0170"},{"id":"urn:ure:t6:occ:callsite:current-client:0065c9c6","call_va":"0x0065C9C6","target_va":"0x005F24E0","section":".text","bytes":"e8155bf9ff","caller_id":"urn:ure:t6:occ:function:current-client:0065c2a0","target_id":"urn:ure:t6:occ:function:current-client:005f24e0"},{"id":"urn:ure:t6:occ:callsite:current-client:0065c9de","call_va":"0x0065C9DE","target_va":"0x004E0170","section":".text","bytes":"e88d37e8ff","caller_id":"urn:ure:t6:occ:function:current-client:0065c2a0","target_id":"urn:ure:t6:occ:function:current-client:004e0170"}] AS rows
