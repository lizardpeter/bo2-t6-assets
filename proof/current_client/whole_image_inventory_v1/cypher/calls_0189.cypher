id":"urn:ure:t6:occ:callsite:current-client:005ce573","call_va":"0x005CE573","target_va":"0x00869D60","section":".text","bytes":"e8e8b72900","caller_id":"urn:ure:t6:occ:function:current-client:005ce3f0","target_id":"urn:ure:t6:occ:function:current-client:00869d60"},{"id":"urn:ure:t6:occ:callsite:current-client:005ce581","call_va":"0x005CE581","target_va":"0x00561660","section":".text","bytes":"e8da30f9ff","caller_id":"urn:ure:t6:occ:function:current-client:005ce3f0","target_id":"urn:ure:t6:occ:function:current-client:00561660"},{"id":"urn:ure:t6:occ:callsite:current-client:005ce59e","call_va":"0x005CE59E","target_va":"0x0045D840","section":".text","bytes":"e89df2e8ff","caller_id":"urn:ure:t6:occ:function:current-client:005ce3f0","target_id":"urn:ure:t6:occ:function:current-client:0045d840"},{"id":"urn:ure:t6:occ:callsite:current-client:005ce5a7","call_va":"0x005CE5A7","target_va":"0x0042E990","section":".text","bytes":"e8e403e6ff","caller_id":"urn:ure:t6:occ:function:current-client:005ce3f0","target_id":"urn:ure:t6:occ:function:current-client:0042e990"},{"id":"urn:ure:t6:occ:callsite:current-client:005ce5b8","call_va":"0x005CE5B8","target_va":"0x00633400","section":".text","bytes":"e8434e0600","caller_id":"urn:ure:t6:occ:function:current-client:005ce3f0","target_id":"urn:ure:t6:occ:function:current-client:00633400"},{"id":"urn:ure:t6:occ:callsite:current-client:005ce5d6","call_va":"0x005CE5D6","target_va":"0x00403AE0","section":".text","bytes":"e80555e3ff","caller_id":"urn:ure:t6:occ:function:current-client:005ce3f0","target_id":"urn:ure:t6:occ:function:current-client:00403ae0"}] AS rows
