id":"urn:ure:t6:occ:callsite:current-client:005d078a","call_va":"0x005D078A","target_va":"0x00657D20","section":".text","bytes":"e891750800","caller_id":"urn:ure:t6:occ:function:current-client:005d02d0","target_id":"urn:ure:t6:occ:function:current-client:00657d20"},{"id":"urn:ure:t6:occ:callsite:current-client:005d0799","call_va":"0x005D0799","target_va":"0x004C6250","section":".text","bytes":"e8b25aefff","caller_id":"urn:ure:t6:occ:function:current-client:005d02d0","target_id":"urn:ure:t6:occ:function:current-client:004c6250"},{"id":"urn:ure:t6:occ:callsite:current-client:005d07c2","call_va":"0x005D07C2","target_va":"0x00650F90","section":".text","bytes":"e8c9070800","caller_id":"urn:ure:t6:occ:function:current-client:005d07c0","target_id":"urn:ure:t6:occ:function:current-client:00650f90"},{"id":"urn:ure:t6:occ:callsite:current-client:005d07ea","call_va":"0x005D07EA","target_va":"0x00909DA0","section":".text","bytes":"e8b1953300","caller_id":"urn:ure:t6:occ:function:current-client:005d07c0","target_id":"urn:ure:t6:occ:function:current-client:00909da0"},{"id":"urn:ure:t6:occ:callsite:current-client:005d0811","call_va":"0x005D0811","target_va":"0x004CA0C0","section":".text","bytes":"e8aa98efff","caller_id":"urn:ure:t6:occ:function:current-client:005d07c0","target_id":"urn:ure:t6:occ:function:current-client:004ca0c0"},{"id":"urn:ure:t6:occ:callsite:current-client:005d0886","call_va":"0x005D0886","target_va":"0x00469590","section":".text","bytes":"e8058de9ff","caller_id":"urn:ure:t6:occ:function:current-client:005d07c0","target_id":"urn:ure:t6:occ:function:current-client:00469590"}] AS rows
