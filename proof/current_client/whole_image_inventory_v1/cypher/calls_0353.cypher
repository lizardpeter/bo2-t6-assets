id":"urn:ure:t6:occ:callsite:current-client:007bb2f7","call_va":"0x007BB2F7","target_va":"0x0058FC30","section":".text","bytes":"e83449ddff","caller_id":"urn:ure:t6:occ:function:current-client:007bb2a0","target_id":"urn:ure:t6:occ:function:current-client:0058fc30"},{"id":"urn:ure:t6:occ:callsite:current-client:007bb303","call_va":"0x007BB303","target_va":"0x00424F00","section":".text","bytes":"e8f89bc6ff","caller_id":"urn:ure:t6:occ:function:current-client:007bb2a0","target_id":"urn:ure:t6:occ:function:current-client:00424f00"},{"id":"urn:ure:t6:occ:callsite:current-client:007bb345","call_va":"0x007BB345","target_va":"0x00546400","section":".text","bytes":"e8b6b0d8ff","caller_id":"urn:ure:t6:occ:function:current-client:007bb320","target_id":"urn:ure:t6:occ:function:current-client:00546400"},{"id":"urn:ure:t6:occ:callsite:current-client:007bb35a","call_va":"0x007BB35A","target_va":"0x00546400","section":".text","bytes":"e8a1b0d8ff","caller_id":"urn:ure:t6:occ:function:current-client:007bb320","target_id":"urn:ure:t6:occ:function:current-client:00546400"},{"id":"urn:ure:t6:occ:callsite:current-client:007bb391","call_va":"0x007BB391","target_va":"0x0058FC30","section":".text","bytes":"e89a48ddff","caller_id":"urn:ure:t6:occ:function:current-client:007bb320","target_id":"urn:ure:t6:occ:function:current-client:0058fc30"},{"id":"urn:ure:t6:occ:callsite:current-client:007bb3ab","call_va":"0x007BB3AB","target_va":"0x007BB2A0","section":".text","bytes":"e8f0feffff","caller_id":"urn:ure:t6:occ:function:current-client:007bb320","target_id":"urn:ure:t6:occ:function:current-client:007bb2a0"}] AS rows
