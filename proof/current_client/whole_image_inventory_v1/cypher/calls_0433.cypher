id":"urn:ure:t6:occ:callsite:current-client:00857a4f","call_va":"0x00857A4F","target_va":"0x00593820","section":".text","bytes":"e8ccbdd3ff","caller_id":"urn:ure:t6:occ:function:current-client:008579f0","target_id":"urn:ure:t6:occ:function:current-client:00593820"},{"id":"urn:ure:t6:occ:callsite:current-client:00857a59","call_va":"0x00857A59","target_va":"0x00415A30","section":".text","bytes":"e8d2dfbbff","caller_id":"urn:ure:t6:occ:function:current-client:008579f0","target_id":"urn:ure:t6:occ:function:current-client:00415a30"},{"id":"urn:ure:t6:occ:callsite:current-client:00857a6c","call_va":"0x00857A6C","target_va":"0x0045BAF0","section":".text","bytes":"e87f40c0ff","caller_id":"urn:ure:t6:occ:function:current-client:008579f0","target_id":"urn:ure:t6:occ:function:current-client:0045baf0"},{"id":"urn:ure:t6:occ:callsite:current-client:00857a7d","call_va":"0x00857A7D","target_va":"0x004C2BF0","section":".text","bytes":"e86eb1c6ff","caller_id":"urn:ure:t6:occ:function:current-client:008579f0","target_id":"urn:ure:t6:occ:function:current-client:004c2bf0"},{"id":"urn:ure:t6:occ:callsite:current-client:00857a88","call_va":"0x00857A88","target_va":"0x00593820","section":".text","bytes":"e893bdd3ff","caller_id":"urn:ure:t6:occ:function:current-client:008579f0","target_id":"urn:ure:t6:occ:function:current-client:00593820"},{"id":"urn:ure:t6:occ:callsite:current-client:00857a92","call_va":"0x00857A92","target_va":"0x00415A30","section":".text","bytes":"e899dfbbff","caller_id":"urn:ure:t6:occ:function:current-client:008579f0","target_id":"urn:ure:t6:occ:function:current-client:00415a30"}] AS rows
