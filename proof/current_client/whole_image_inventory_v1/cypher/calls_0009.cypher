id":"urn:ure:t6:occ:callsite:current-client:0041a40c","call_va":"0x0041A40C","target_va":"0x004E0170","section":".text","bytes":"e85f5d0c00","caller_id":"urn:ure:t6:occ:function:current-client:00419e6a","target_id":"urn:ure:t6:occ:function:current-client:004e0170"},{"id":"urn:ure:t6:occ:callsite:current-client:0041a424","call_va":"0x0041A424","target_va":"0x004E0170","section":".text","bytes":"e8475d0c00","caller_id":"urn:ure:t6:occ:function:current-client:00419e6a","target_id":"urn:ure:t6:occ:function:current-client:004e0170"},{"id":"urn:ure:t6:occ:callsite:current-client:0041a43c","call_va":"0x0041A43C","target_va":"0x004E0170","section":".text","bytes":"e82f5d0c00","caller_id":"urn:ure:t6:occ:function:current-client:00419e6a","target_id":"urn:ure:t6:occ:function:current-client:004e0170"},{"id":"urn:ure:t6:occ:callsite:current-client:0041a457","call_va":"0x0041A457","target_va":"0x004E0170","section":".text","bytes":"e8145d0c00","caller_id":"urn:ure:t6:occ:function:current-client:00419e6a","target_id":"urn:ure:t6:occ:function:current-client:004e0170"},{"id":"urn:ure:t6:occ:callsite:current-client:0041a46f","call_va":"0x0041A46F","target_va":"0x004E0170","section":".text","bytes":"e8fc5c0c00","caller_id":"urn:ure:t6:occ:function:current-client:00419e6a","target_id":"urn:ure:t6:occ:function:current-client:004e0170"},{"id":"urn:ure:t6:occ:callsite:current-client:0041a487","call_va":"0x0041A487","target_va":"0x004E0170","section":".text","bytes":"e8e45c0c00","caller_id":"urn:ure:t6:occ:function:current-client:00419e6a","target_id":"urn:ure:t6:occ:function:current-client:004e0170"}] AS rows
