id":"urn:ure:t6:occ:callsite:current-client:008bb615","call_va":"0x008BB615","target_va":"0x004C0830","section":".text","bytes":"e81652c0ff","caller_id":"urn:ure:t6:occ:function:current-client:008bb500","target_id":"urn:ure:t6:occ:function:current-client:004c0830"},{"id":"urn:ure:t6:occ:callsite:current-client:008bb622","call_va":"0x008BB622","target_va":"0x004124E0","section":".text","bytes":"e8b96eb5ff","caller_id":"urn:ure:t6:occ:function:current-client:008bb500","target_id":"urn:ure:t6:occ:function:current-client:004124e0"},{"id":"urn:ure:t6:occ:callsite:current-client:008bb632","call_va":"0x008BB632","target_va":"0x004C0830","section":".text","bytes":"e8f951c0ff","caller_id":"urn:ure:t6:occ:function:current-client:008bb500","target_id":"urn:ure:t6:occ:function:current-client:004c0830"},{"id":"urn:ure:t6:occ:callsite:current-client:008bb6b0","call_va":"0x008BB6B0","target_va":"0x00709870","section":".text","bytes":"e8bbe1e4ff","caller_id":"urn:ure:t6:occ:function:current-client:008bb500","target_id":"urn:ure:t6:occ:function:current-client:00709870"},{"id":"urn:ure:t6:occ:callsite:current-client:008bb6e0","call_va":"0x008BB6E0","target_va":"0x00A7301A","section":".text","bytes":"e835791b00","caller_id":"urn:ure:t6:occ:function:current-client:008bb500","target_id":"urn:ure:t6:occ:function:current-client:00a7301a"},{"id":"urn:ure:t6:occ:callsite:current-client:008bb6ee","call_va":"0x008BB6EE","target_va":"0x006B2520","section":".text","bytes":"e82d6edfff","caller_id":"urn:ure:t6:occ:function:current-client:008bb500","target_id":"urn:ure:t6:occ:function:current-client:006b2520"}] AS rows
UNWIND rows AS row
MATCH (target:KGNode {id:row.target_id})
MERGE (c:KGNode {id:row.id})
SET c.kind='core:Occurrence', c.occurrence_type='direct-callsite', c.namespace='t6', c.build_id=b.id, c.artifact_id=a.id,
    c.address_space='va', c.address_start=row.call_va, c.target_va=row.target_va, c.section_name=row.section,
    c.instruction_bytes=row.bytes, c.caller_assignment_state=CASE WHEN row.caller_id IS NULL THEN 'unassigned' ELSE 'nearest-preceding-entry-candidate' END,
    c.producer='t6-current-client-whole-image-mechanical-inventory-v1'
MERGE (b)-[:HAS_OCCURRENCE]->(c)
MERGE (c)-[:DEFINED_IN]->(a)
MERGE (c)-[:CALLS_TARGET]->(target)
FOREACH (_ IN CASE WHEN row.caller_id IS NULL THEN [] ELSE [1] END |
  MERGE (caller:KGNode {id:row.caller_id})
  MERGE (caller)-[:HAS_CALLSITE]->(c)
)
