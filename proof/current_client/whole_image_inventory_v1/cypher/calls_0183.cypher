id":"urn:ure:t6:occ:callsite:current-client:005c0838","call_va":"0x005C0838","target_va":"0x00664360","section":".text","bytes":"e8233b0a00","caller_id":"urn:ure:t6:occ:function:current-client:005c0800","target_id":"urn:ure:t6:occ:function:current-client:00664360"},{"id":"urn:ure:t6:occ:callsite:current-client:005c084d","call_va":"0x005C084D","target_va":"0x0047DF80","section":".text","bytes":"e82ed7ebff","caller_id":"urn:ure:t6:occ:function:current-client:005c0800","target_id":"urn:ure:t6:occ:function:current-client:0047df80"},{"id":"urn:ure:t6:occ:callsite:current-client:005c085e","call_va":"0x005C085E","target_va":"0x00614D20","section":".text","bytes":"e8bd440500","caller_id":"urn:ure:t6:occ:function:current-client:005c0800","target_id":"urn:ure:t6:occ:function:current-client:00614d20"},{"id":"urn:ure:t6:occ:callsite:current-client:005c0869","call_va":"0x005C0869","target_va":"0x00593820","section":".text","bytes":"e8b22ffdff","caller_id":"urn:ure:t6:occ:function:current-client:005c0800","target_id":"urn:ure:t6:occ:function:current-client:00593820"},{"id":"urn:ure:t6:occ:callsite:current-client:005c0886","call_va":"0x005C0886","target_va":"0x00664360","section":".text","bytes":"e8d53a0a00","caller_id":"urn:ure:t6:occ:function:current-client:005c0800","target_id":"urn:ure:t6:occ:function:current-client:00664360"},{"id":"urn:ure:t6:occ:callsite:current-client:005c089b","call_va":"0x005C089B","target_va":"0x0047DF80","section":".text","bytes":"e8e0d6ebff","caller_id":"urn:ure:t6:occ:function:current-client:005c0800","target_id":"urn:ure:t6:occ:function:current-client:0047df80"}] AS rows
