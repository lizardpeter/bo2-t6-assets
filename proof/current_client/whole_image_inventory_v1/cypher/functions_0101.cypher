arget"},{"id":"urn:ure:t6:occ:function:current-client:00b09f70","va":"0x00B09F70","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:00b09fa0","va":"0x00B09FA0","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:00b09fd0","va":"0x00B09FD0","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:00b0a110","va":"0x00B0A110","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:00b0a140","va":"0x00B0A140","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:00b0a180","va":"0x00B0A180","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:00b0a190","va":"0x00B0A190","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:00b0a200","va":"0x00B0A200","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:00b0a290","va":"0x00B0A290","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:00b0a2e0","va":"0x00B0A2E0","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"}] AS rows
UNWIND rows AS row
MERGE (n:KGNode {id:row.id})
ON CREATE SET n.kind='re:FunctionOccurrence', n.namespace='t6', n.build_id=b.id, n.artifact_id=a.id,
    n.display_name='sub_'+substring(row.va,2), n.address_space='va', n.address_start=row.va
SET n.entry_basis=row.basis, n.entry_strongest_basis=row.strongest_basis,
    n.boundary_state=CASE WHEN coalesce(n.boundary_state,'') STARTS WITH 'exact-' THEN n.boundary_state ELSE 'entry-only-mechanical-inventory' END,
    n.producer=CASE WHEN n.producer IS NULL THEN 't6-current-client-whole-image-mechanical-inventory-v1' ELSE n.producer END
MERGE (b)-[:HAS_OCCURRENCE]->(n)
MERGE (n)-[:DEFINED_IN]->(a)
