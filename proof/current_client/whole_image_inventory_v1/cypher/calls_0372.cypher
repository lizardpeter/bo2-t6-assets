id":"urn:ure:t6:occ:callsite:current-client:007dbf22","call_va":"0x007DBF22","target_va":"0x004048B0","section":".text","bytes":"e88989c2ff","caller_id":"urn:ure:t6:occ:function:current-client:007dbd40","target_id":"urn:ure:t6:occ:function:current-client:004048b0"},{"id":"urn:ure:t6:occ:callsite:current-client:007dbf28","call_va":"0x007DBF28","target_va":"0x005C35B0","section":".text","bytes":"e88376deff","caller_id":"urn:ure:t6:occ:function:current-client:007dbd40","target_id":"urn:ure:t6:occ:function:current-client:005c35b0"},{"id":"urn:ure:t6:occ:callsite:current-client:007dbf5b","call_va":"0x007DBF5B","target_va":"0x00734020","section":".text","bytes":"e8c080f5ff","caller_id":"urn:ure:t6:occ:function:current-client:007dbd40","target_id":"urn:ure:t6:occ:function:current-client:00734020"},{"id":"urn:ure:t6:occ:callsite:current-client:007dbfe8","call_va":"0x007DBFE8","target_va":"0x004048B0","section":".text","bytes":"e8c388c2ff","caller_id":"urn:ure:t6:occ:function:current-client:007dbd40","target_id":"urn:ure:t6:occ:function:current-client:004048b0"},{"id":"urn:ure:t6:occ:callsite:current-client:007dc007","call_va":"0x007DC007","target_va":"0x006B8EB0","section":".text","bytes":"e8a4ceedff","caller_id":"urn:ure:t6:occ:function:current-client:007dbd40","target_id":"urn:ure:t6:occ:function:current-client:006b8eb0"},{"id":"urn:ure:t6:occ:callsite:current-client:007dc013","call_va":"0x007DC013","target_va":"0x0046B2E0","section":".text","bytes":"e8c8f2c8ff","caller_id":"urn:ure:t6:occ:function:current-client:007dbd40","target_id":"urn:ure:t6:occ:function:current-client:0046b2e0"}] AS rows
UNWIND rows AS row
MATCH (target:KGNode {id:row.target_id})
MERGE (c:KGNode {id:row.id})
SET c.kind='core:Occurrence', c.occurrence_type='direct-callsite', c.namespace='t6', c.build_id=b.id, c.artifact_id=a.id,
