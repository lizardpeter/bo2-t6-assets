id":"urn:ure:t6:occ:callsite:current-client:008f74de","call_va":"0x008F74DE","target_va":"0x004C78D0","section":".text","bytes":"e8ed03bdff","caller_id":"urn:ure:t6:occ:function:current-client:008f5620","target_id":"urn:ure:t6:occ:function:current-client:004c78d0"},{"id":"urn:ure:t6:occ:callsite:current-client:008f74e5","call_va":"0x008F74E5","target_va":"0x00436540","section":".text","bytes":"e856f0b3ff","caller_id":"urn:ure:t6:occ:function:current-client:008f5620","target_id":"urn:ure:t6:occ:function:current-client:00436540"},{"id":"urn:ure:t6:occ:callsite:current-client:008f74ef","call_va":"0x008F74EF","target_va":"0x0043A960","section":".text","bytes":"e86c34b4ff","caller_id":"urn:ure:t6:occ:function:current-client:008f5620","target_id":"urn:ure:t6:occ:function:current-client:0043a960"},{"id":"urn:ure:t6:occ:callsite:current-client:008f74f9","call_va":"0x008F74F9","target_va":"0x005070C0","section":".text","bytes":"e8c2fbc0ff","caller_id":"urn:ure:t6:occ:function:current-client:008f5620","target_id":"urn:ure:t6:occ:function:current-client:005070c0"},{"id":"urn:ure:t6:occ:callsite:current-client:008f751f","call_va":"0x008F751F","target_va":"0x0043A960","section":".text","bytes":"e83c34b4ff","caller_id":"urn:ure:t6:occ:function:current-client:008f5620","target_id":"urn:ure:t6:occ:function:current-client:0043a960"},{"id":"urn:ure:t6:occ:callsite:current-client:008f7526","call_va":"0x008F7526","target_va":"0x00436540","section":".text","bytes":"e815f0b3ff","caller_id":"urn:ure:t6:occ:function:current-client:008f5620","target_id":"urn:ure:t6:occ:function:current-client:00436540"}] AS rows
