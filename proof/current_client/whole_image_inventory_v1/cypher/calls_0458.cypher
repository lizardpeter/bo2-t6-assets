id":"urn:ure:t6:occ:callsite:current-client:0089950c","call_va":"0x0089950C","target_va":"0x006CB730","section":".text","bytes":"e81f22e3ff","caller_id":"urn:ure:t6:occ:function:current-client:008994b0","target_id":"urn:ure:t6:occ:function:current-client:006cb730"},{"id":"urn:ure:t6:occ:callsite:current-client:00899511","call_va":"0x00899511","target_va":"0x00656E50","section":".text","bytes":"e83ad9dbff","caller_id":"urn:ure:t6:occ:function:current-client:008994b0","target_id":"urn:ure:t6:occ:function:current-client:00656e50"},{"id":"urn:ure:t6:occ:callsite:current-client:00899525","call_va":"0x00899525","target_va":"0x005EA530","section":".text","bytes":"e80610d5ff","caller_id":"urn:ure:t6:occ:function:current-client:008994b0","target_id":"urn:ure:t6:occ:function:current-client:005ea530"},{"id":"urn:ure:t6:occ:callsite:current-client:00899546","call_va":"0x00899546","target_va":"0x005EFBA0","section":".text","bytes":"e85566d5ff","caller_id":"urn:ure:t6:occ:function:current-client:008994b0","target_id":"urn:ure:t6:occ:function:current-client:005efba0"},{"id":"urn:ure:t6:occ:callsite:current-client:00899564","call_va":"0x00899564","target_va":"0x005EFBA0","section":".text","bytes":"e83766d5ff","caller_id":"urn:ure:t6:occ:function:current-client:008994b0","target_id":"urn:ure:t6:occ:function:current-client:005efba0"},{"id":"urn:ure:t6:occ:callsite:current-client:0089958d","call_va":"0x0089958D","target_va":"0x004BE8A0","section":".text","bytes":"e80e53c2ff","caller_id":"urn:ure:t6:occ:function:current-client:008994b0","target_id":"urn:ure:t6:occ:function:current-client:004be8a0"}] AS rows
