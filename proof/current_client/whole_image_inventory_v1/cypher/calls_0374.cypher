id":"urn:ure:t6:occ:callsite:current-client:007e1415","call_va":"0x007E1415","target_va":"0x004645D0","section":".text","bytes":"e8b631c8ff","caller_id":"urn:ure:t6:occ:function:current-client:007e1320","target_id":"urn:ure:t6:occ:function:current-client:004645d0"},{"id":"urn:ure:t6:occ:callsite:current-client:007e148d","call_va":"0x007E148D","target_va":"0x00571A10","section":".text","bytes":"e87e05d9ff","caller_id":"urn:ure:t6:occ:function:current-client:007e1450","target_id":"urn:ure:t6:occ:function:current-client:00571a10"},{"id":"urn:ure:t6:occ:callsite:current-client:007e1498","call_va":"0x007E1498","target_va":"0x00571A10","section":".text","bytes":"e87305d9ff","caller_id":"urn:ure:t6:occ:function:current-client:007e1450","target_id":"urn:ure:t6:occ:function:current-client:00571a10"},{"id":"urn:ure:t6:occ:callsite:current-client:007e14ac","call_va":"0x007E14AC","target_va":"0x006E5F20","section":".text","bytes":"e86f4af0ff","caller_id":"urn:ure:t6:occ:function:current-client:007e1450","target_id":"urn:ure:t6:occ:function:current-client:006e5f20"},{"id":"urn:ure:t6:occ:callsite:current-client:007e14be","call_va":"0x007E14BE","target_va":"0x004EAC30","section":".text","bytes":"e86d97d0ff","caller_id":"urn:ure:t6:occ:function:current-client:007e1450","target_id":"urn:ure:t6:occ:function:current-client:004eac30"},{"id":"urn:ure:t6:occ:callsite:current-client:007e14c4","call_va":"0x007E14C4","target_va":"0x0054A0D0","section":".text","bytes":"e8078cd6ff","caller_id":"urn:ure:t6:occ:function:current-client:007e1450","target_id":"urn:ure:t6:occ:function:current-client:0054a0d0"}] AS rows
