,strongest_basis:"direct-call-target"},{id:"urn:ure:t6:occ:function:current-client:00b2b1d0",va:"0x00B2B1D0",section:".text",basis:"direct-call-target",strongest_basis:"direct-call-target"},{id:"urn:ure:t6:occ:function:current-client:00b2b560",va:"0x00B2B560",section:".text",basis:"direct-call-target",strongest_basis:"direct-call-target"},{id:"urn:ure:t6:occ:function:current-client:00b2b980",va:"0x00B2B980",section:".text",basis:"direct-call-target;post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:00b2b9f0",va:"0x00B2B9F0",section:".text",basis:"direct-call-target",strongest_basis:"direct-call-target"},{id:"urn:ure:t6:occ:function:current-client:00b2ba10",va:"0x00B2BA10",section:".text",basis:"direct-call-target",strongest_basis:"direct-call-target"},{id:"urn:ure:t6:occ:function:current-client:00b2ba30",va:"0x00B2BA30",section:".text",basis:"direct-call-target;post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:00b2ba40",va:"0x00B2BA40",section:".text",basis:"direct-call-target",strongest_basis:"direct-call-target"},{id:"urn:ure:t6:occ:function:current-client:00b2ba60",va:"0x00B2BA60",section:".text",basis:"direct-call-target;post-int3-padding",strongest_basis:"post-int3-padding"}] AS rows
UNWIND rows AS row
MERGE (n:KGNode {id:row.id})
ON CREATE SET n._mechanical_inventory_new=true,
    n.kind='re:FunctionOccurrence', n.namespace='t6', n.build_id=b.id, n.artifact_id=a.id,
    n.display_name='sub_'+substring(row.va,2), n.address_space='va', n.address_start=row.va
SET n.entry_basis=row.basis, n.entry_strongest_basis=row.strongest_basis,
    n.boundary_state=CASE WHEN coalesce(n.boundary_state,'') STARTS WITH 'exact-' THEN n.boundary_state ELSE 'entry-only-mechanical-inventory' END,
    n.producer=CASE WHEN n.producer IS NULL THEN 't6-current-client-whole-image-mechanical-inventory-v1' ELSE n.producer END
WITH b,a,n,coalesce(n._mechanical_inventory_new,false) AS is_new
FOREACH (_ IN CASE WHEN is_new THEN [1] ELSE [] END |
  CREATE (b)-[:HAS_OCCURRENCE]->(n)
  CREATE (n)-[:DEFINED_IN]->(a)
)
REMOVE n._mechanical_inventory_new
