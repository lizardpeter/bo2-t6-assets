id":"urn:ure:t6:occ:callsite:current-client:007d0a4e","call_va":"0x007D0A4E","target_va":"0x0066FBB0","section":".text","bytes":"e85df1e9ff","caller_id":"urn:ure:t6:occ:function:current-client:007d09d0","target_id":"urn:ure:t6:occ:function:current-client:0066fbb0"},{"id":"urn:ure:t6:occ:callsite:current-client:007d0a61","call_va":"0x007D0A61","target_va":"0x0066FBB0","section":".text","bytes":"e84af1e9ff","caller_id":"urn:ure:t6:occ:function:current-client:007d09d0","target_id":"urn:ure:t6:occ:function:current-client:0066fbb0"},{"id":"urn:ure:t6:occ:callsite:current-client:007d0a73","call_va":"0x007D0A73","target_va":"0x0066FBB0","section":".text","bytes":"e838f1e9ff","caller_id":"urn:ure:t6:occ:function:current-client:007d09d0","target_id":"urn:ure:t6:occ:function:current-client:0066fbb0"},{"id":"urn:ure:t6:occ:callsite:current-client:007d0a86","call_va":"0x007D0A86","target_va":"0x0066FBB0","section":".text","bytes":"e825f1e9ff","caller_id":"urn:ure:t6:occ:function:current-client:007d09d0","target_id":"urn:ure:t6:occ:function:current-client:0066fbb0"},{"id":"urn:ure:t6:occ:callsite:current-client:007d0a99","call_va":"0x007D0A99","target_va":"0x0066FBB0","section":".text","bytes":"e812f1e9ff","caller_id":"urn:ure:t6:occ:function:current-client:007d09d0","target_id":"urn:ure:t6:occ:function:current-client:0066fbb0"},{"id":"urn:ure:t6:occ:callsite:current-client:007d0aab","call_va":"0x007D0AAB","target_va":"0x0066FBB0","section":".text","bytes":"e800f1e9ff","caller_id":"urn:ure:t6:occ:function:current-client:007d09d0","target_id":"urn:ure:t6:occ:function:current-client:0066fbb0"}] AS rows
UNWIND rows AS row
MATCH (target:KGNode {id:row.target_id})
MERGE (c:KGNode {id:row.id})
SET c.kind='core:Occurrence', c.occurrence_type='direct-callsite', c.namespace='t6', c.build_id=b.id, c.artifact_id=a.id,
    c.address_space='va', c.address_start=row.call_va, c.target_va=row.target_va, c.section_name=row.section,
    c.instruction_bytes=row.bytes, c.caller_assignment_state=CASE WHEN row.caller_id IS NULL THEN 'unassigned' ELSE 'nearest-preceding-entry-candidate' END,
    c.producer='t6-current-client-whole-image-mechanical-inventory-v1'
MERGE (b)-[:HAS_OCCURRENCE]->(c)
MERGE (c)-[:DEFINED_IN]->(a)
MERGE (c)-[:CALLS_TARGET]->(target)
FOREACH (_ IN CASE WHEN row.caller_id IS NULL THEN [] ELSE [1] END |
  MERGE (caller:KGNode {id:row.caller_id})
  MERGE (caller)-[:HAS_CALLSITE]->(c)
)
