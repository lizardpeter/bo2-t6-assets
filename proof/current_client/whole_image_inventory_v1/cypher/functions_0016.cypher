A4A0","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:004fa590","va":"0x004FA590","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:004fa670","va":"0x004FA670","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:004fa8f0","va":"0x004FA8F0","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:004fa930","va":"0x004FA930","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:004fa970","va":"0x004FA970","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:004fa990","va":"0x004FA990","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:004fa9c0","va":"0x004FA9C0","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:004faa10","va":"0x004FAA10","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:004faba0","va":"0x004FABA0","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:004fabc0","va":"0x004FABC0","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:004fac40","va":"0x004FAC40","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"}] AS rows
UNWIND rows AS row
MERGE (n:KGNode {id:row.id})
ON CREATE SET n.kind='re:FunctionOccurrence', n.namespace='t6', n.build_id=b.id, n.artifact_id=a.id,
    n.display_name='sub_'+substring(row.va,2), n.address_space='va', n.address_start=row.va
SET n.entry_basis=row.basis, n.entry_strongest_basis=row.strongest_basis,
    n.boundary_state=CASE WHEN coalesce(n.boundary_state,'') STARTS WITH 'exact-' THEN n.boundary_state ELSE 'entry-only-mechanical-inventory' END,
    n.producer=CASE WHEN n.producer IS NULL THEN 't6-current-client-whole-image-mechanical-inventory-v1' ELSE n.producer END
MERGE (b)-[:HAS_OCCURRENCE]->(n)
MERGE (n)-[:DEFINED_IN]->(a)
