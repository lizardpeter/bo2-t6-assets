id":"urn:ure:t6:occ:callsite:current-client:007f203d","call_va":"0x007F203D","target_va":"0x00701040","section":".text","bytes":"e8feeff0ff","caller_id":"urn:ure:t6:occ:function:current-client:007f17e0","target_id":"urn:ure:t6:occ:function:current-client:00701040"},{"id":"urn:ure:t6:occ:callsite:current-client:007f2049","call_va":"0x007F2049","target_va":"0x005535A0","section":".text","bytes":"e85215d6ff","caller_id":"urn:ure:t6:occ:function:current-client:007f17e0","target_id":"urn:ure:t6:occ:function:current-client:005535a0"},{"id":"urn:ure:t6:occ:callsite:current-client:007f2056","call_va":"0x007F2056","target_va":"0x0054AEF0","section":".text","bytes":"e8958ed5ff","caller_id":"urn:ure:t6:occ:function:current-client:007f17e0","target_id":"urn:ure:t6:occ:function:current-client:0054aef0"},{"id":"urn:ure:t6:occ:callsite:current-client:007f2069","call_va":"0x007F2069","target_va":"0x0056D530","section":".text","bytes":"e8c2b4d7ff","caller_id":"urn:ure:t6:occ:function:current-client:007f17e0","target_id":"urn:ure:t6:occ:function:current-client:0056d530"},{"id":"urn:ure:t6:occ:callsite:current-client:007f2075","call_va":"0x007F2075","target_va":"0x0058C0A0","section":".text","bytes":"e826a0d9ff","caller_id":"urn:ure:t6:occ:function:current-client:007f17e0","target_id":"urn:ure:t6:occ:function:current-client:0058c0a0"},{"id":"urn:ure:t6:occ:callsite:current-client:007f20ae","call_va":"0x007F20AE","target_va":"0x00482010","section":".text","bytes":"e85dffc8ff","caller_id":"urn:ure:t6:occ:function:current-client:007f17e0","target_id":"urn:ure:t6:occ:function:current-client:00482010"}] AS rows
