id":"urn:ure:t6:occ:callsite:current-client:0097c14e","call_va":"0x0097C14E","target_va":"0x0043A8F0","section":".text","bytes":"e89de7abff","caller_id":"urn:ure:t6:occ:function:current-client:0097bfd0","target_id":"urn:ure:t6:occ:function:current-client:0043a8f0"},{"id":"urn:ure:t6:occ:callsite:current-client:0097c155","call_va":"0x0097C155","target_va":"0x00444640","section":".text","bytes":"e8e684acff","caller_id":"urn:ure:t6:occ:function:current-client:0097bfd0","target_id":"urn:ure:t6:occ:function:current-client:00444640"},{"id":"urn:ure:t6:occ:callsite:current-client:0097c180","call_va":"0x0097C180","target_va":"0x006AD580","section":".text","bytes":"e8fb13d3ff","caller_id":"urn:ure:t6:occ:function:current-client:0097bfd0","target_id":"urn:ure:t6:occ:function:current-client:006ad580"},{"id":"urn:ure:t6:occ:callsite:current-client:0097c1b0","call_va":"0x0097C1B0","target_va":"0x006AD580","section":".text","bytes":"e8cb13d3ff","caller_id":"urn:ure:t6:occ:function:current-client:0097bfd0","target_id":"urn:ure:t6:occ:function:current-client:006ad580"},{"id":"urn:ure:t6:occ:callsite:current-client:0097c1c9","call_va":"0x0097C1C9","target_va":"0x006AD580","section":".text","bytes":"e8b213d3ff","caller_id":"urn:ure:t6:occ:function:current-client:0097bfd0","target_id":"urn:ure:t6:occ:function:current-client:006ad580"},{"id":"urn:ure:t6:occ:callsite:current-client:0097c1e5","call_va":"0x0097C1E5","target_va":"0x005FB2F0","section":".text","bytes":"e806f1c7ff","caller_id":"urn:ure:t6:occ:function:current-client:0097bfd0","target_id":"urn:ure:t6:occ:function:current-client:005fb2f0"}] AS rows
