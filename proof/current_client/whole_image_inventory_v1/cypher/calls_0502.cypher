id":"urn:ure:t6:occ:callsite:current-client:0091731b","call_va":"0x0091731B","target_va":"0x00458BC0","section":".text","bytes":"e8a018b4ff","caller_id":"urn:ure:t6:occ:function:current-client:009172f0","target_id":"urn:ure:t6:occ:function:current-client:00458bc0"},{"id":"urn:ure:t6:occ:callsite:current-client:00917321","call_va":"0x00917321","target_va":"0x0047DF80","section":".text","bytes":"e85a6cb6ff","caller_id":"urn:ure:t6:occ:function:current-client:009172f0","target_id":"urn:ure:t6:occ:function:current-client:0047df80"},{"id":"urn:ure:t6:occ:callsite:current-client:00917341","call_va":"0x00917341","target_va":"0x0042D650","section":".text","bytes":"e80a63b1ff","caller_id":"urn:ure:t6:occ:function:current-client:009172f0","target_id":"urn:ure:t6:occ:function:current-client:0042d650"},{"id":"urn:ure:t6:occ:callsite:current-client:0091734c","call_va":"0x0091734C","target_va":"0x0048C700","section":".text","bytes":"e8af53b7ff","caller_id":"urn:ure:t6:occ:function:current-client:009172f0","target_id":"urn:ure:t6:occ:function:current-client:0048c700"},{"id":"urn:ure:t6:occ:callsite:current-client:00917394","call_va":"0x00917394","target_va":"0x0057EC40","section":".text","bytes":"e8a778c6ff","caller_id":"urn:ure:t6:occ:function:current-client:00917370","target_id":"urn:ure:t6:occ:function:current-client:0057ec40"},{"id":"urn:ure:t6:occ:callsite:current-client:009173e6","call_va":"0x009173E6","target_va":"0x00A439D0","section":".text","bytes":"e8e5c51200","caller_id":"urn:ure:t6:occ:function:current-client:00917370","target_id":"urn:ure:t6:occ:function:current-client:00a439d0"}] AS rows
