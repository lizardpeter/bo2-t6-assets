id":"urn:ure:t6:occ:callsite:current-client:00945f3f","call_va":"0x00945F3F","target_va":"0x004E2660","section":".text","bytes":"e81cc7b9ff","caller_id":"urn:ure:t6:occ:function:current-client:00945c50","target_id":"urn:ure:t6:occ:function:current-client:004e2660"},{"id":"urn:ure:t6:occ:callsite:current-client:00945f65","call_va":"0x00945F65","target_va":"0x00941610","section":".text","bytes":"e8a6b6ffff","caller_id":"urn:ure:t6:occ:function:current-client:00945c50","target_id":"urn:ure:t6:occ:function:current-client:00941610"},{"id":"urn:ure:t6:occ:callsite:current-client:00945f72","call_va":"0x00945F72","target_va":"0x006A32F0","section":".text","bytes":"e879d3d5ff","caller_id":"urn:ure:t6:occ:function:current-client:00945c50","target_id":"urn:ure:t6:occ:function:current-client:006a32f0"},{"id":"urn:ure:t6:occ:callsite:current-client:00945f82","call_va":"0x00945F82","target_va":"0x005DC170","section":".text","bytes":"e8e961c9ff","caller_id":"urn:ure:t6:occ:function:current-client:00945c50","target_id":"urn:ure:t6:occ:function:current-client:005dc170"},{"id":"urn:ure:t6:occ:callsite:current-client:0094602f","call_va":"0x0094602F","target_va":"0x00680A80","section":".text","bytes":"e84caad3ff","caller_id":"urn:ure:t6:occ:function:current-client:00945fa0","target_id":"urn:ure:t6:occ:function:current-client:00680a80"},{"id":"urn:ure:t6:occ:callsite:current-client:009460e9","call_va":"0x009460E9","target_va":"0x00941AF0","section":".text","bytes":"e802baffff","caller_id":"urn:ure:t6:occ:function:current-client:00945fa0","target_id":"urn:ure:t6:occ:function:current-client:00941af0"}] AS rows
