id":"urn:ure:t6:occ:callsite:current-client:00540551","call_va":"0x00540551","target_va":"0x004F1FC0","section":".text","bytes":"e86a1afbff","caller_id":"urn:ure:t6:occ:function:current-client:0053f6b0","target_id":"urn:ure:t6:occ:function:current-client:004f1fc0"},{"id":"urn:ure:t6:occ:callsite:current-client:00540589","call_va":"0x00540589","target_va":"0x00449700","section":".text","bytes":"e87291f0ff","caller_id":"urn:ure:t6:occ:function:current-client:0053f6b0","target_id":"urn:ure:t6:occ:function:current-client:00449700"},{"id":"urn:ure:t6:occ:callsite:current-client:005405ac","call_va":"0x005405AC","target_va":"0x005225F0","section":".text","bytes":"e83f20feff","caller_id":"urn:ure:t6:occ:function:current-client:005405a0","target_id":"urn:ure:t6:occ:function:current-client:005225f0"},{"id":"urn:ure:t6:occ:callsite:current-client:005406bf","call_va":"0x005406BF","target_va":"0x0045DC40","section":".text","bytes":"e87cd5f1ff","caller_id":"urn:ure:t6:occ:function:current-client:005405a0","target_id":"urn:ure:t6:occ:function:current-client:0045dc40"},{"id":"urn:ure:t6:occ:callsite:current-client:0054070b","call_va":"0x0054070B","target_va":"0x006EE920","section":".text","bytes":"e810e21a00","caller_id":"urn:ure:t6:occ:function:current-client:005405a0","target_id":"urn:ure:t6:occ:function:current-client:006ee920"},{"id":"urn:ure:t6:occ:callsite:current-client:00540721","call_va":"0x00540721","target_va":"0x0045BCF0","section":".text","bytes":"e8cab5f1ff","caller_id":"urn:ure:t6:occ:function:current-client:005405a0","target_id":"urn:ure:t6:occ:function:current-client:0045bcf0"}] AS rows
