id":"urn:ure:t6:occ:callsite:current-client:0097753c","call_va":"0x0097753C","target_va":"0x0045BD90","section":".text","bytes":"e84f48aeff","caller_id":"urn:ure:t6:occ:function:current-client:009774d0","target_id":"urn:ure:t6:occ:function:current-client:0045bd90"},{"id":"urn:ure:t6:occ:callsite:current-client:00977583","call_va":"0x00977583","target_va":"0x005FB2F0","section":".text","bytes":"e8683dc8ff","caller_id":"urn:ure:t6:occ:function:current-client:009774d0","target_id":"urn:ure:t6:occ:function:current-client:005fb2f0"},{"id":"urn:ure:t6:occ:callsite:current-client:0097758b","call_va":"0x0097758B","target_va":"0x00A74EF0","section":".text","bytes":"e860d90f00","caller_id":"urn:ure:t6:occ:function:current-client:009774d0","target_id":"urn:ure:t6:occ:function:current-client:00a74ef0"},{"id":"urn:ure:t6:occ:callsite:current-client:00977591","call_va":"0x00977591","target_va":"0x00705300","section":".text","bytes":"e86addd8ff","caller_id":"urn:ure:t6:occ:function:current-client:009774d0","target_id":"urn:ure:t6:occ:function:current-client:00705300"},{"id":"urn:ure:t6:occ:callsite:current-client:00977597","call_va":"0x00977597","target_va":"0x004576B0","section":".text","bytes":"e81401aeff","caller_id":"urn:ure:t6:occ:function:current-client:009774d0","target_id":"urn:ure:t6:occ:function:current-client:004576b0"},{"id":"urn:ure:t6:occ:callsite:current-client:009775d3","call_va":"0x009775D3","target_va":"0x005FB2F0","section":".text","bytes":"e8183dc8ff","caller_id":"urn:ure:t6:occ:function:current-client:009774d0","target_id":"urn:ure:t6:occ:function:current-client:005fb2f0"}] AS rows
