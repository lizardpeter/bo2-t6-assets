id":"urn:ure:t6:occ:callsite:current-client:007a3b29","call_va":"0x007A3B29","target_va":"0x00457CE0","section":".text","bytes":"e8b241cbff","caller_id":"urn:ure:t6:occ:function:current-client:007a3a80","target_id":"urn:ure:t6:occ:function:current-client:00457ce0"},{"id":"urn:ure:t6:occ:callsite:current-client:007a3b8a","call_va":"0x007A3B8A","target_va":"0x005D0F30","section":".text","bytes":"e8a1d3e2ff","caller_id":"urn:ure:t6:occ:function:current-client:007a3a80","target_id":"urn:ure:t6:occ:function:current-client:005d0f30"},{"id":"urn:ure:t6:occ:callsite:current-client:007a3bb8","call_va":"0x007A3BB8","target_va":"0x005D0F30","section":".text","bytes":"e873d3e2ff","caller_id":"urn:ure:t6:occ:function:current-client:007a3a80","target_id":"urn:ure:t6:occ:function:current-client:005d0f30"},{"id":"urn:ure:t6:occ:callsite:current-client:007a3bd0","call_va":"0x007A3BD0","target_va":"0x004B63D0","section":".text","bytes":"e8fb27d1ff","caller_id":"urn:ure:t6:occ:function:current-client:007a3a80","target_id":"urn:ure:t6:occ:function:current-client:004b63d0"},{"id":"urn:ure:t6:occ:callsite:current-client:007a3bd8","call_va":"0x007A3BD8","target_va":"0x00427660","section":".text","bytes":"e8833ac8ff","caller_id":"urn:ure:t6:occ:function:current-client:007a3a80","target_id":"urn:ure:t6:occ:function:current-client:00427660"},{"id":"urn:ure:t6:occ:callsite:current-client:007a3bdf","call_va":"0x007A3BDF","target_va":"0x005DF7A0","section":".text","bytes":"e8bcbbe3ff","caller_id":"urn:ure:t6:occ:function:current-client:007a3a80","target_id":"urn:ure:t6:occ:function:current-client:005df7a0"}] AS rows
