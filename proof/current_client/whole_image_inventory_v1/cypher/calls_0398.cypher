id":"urn:ure:t6:occ:callsite:current-client:008212aa","call_va":"0x008212AA","target_va":"0x004C0290","section":".text","bytes":"e8e1efc9ff","caller_id":"urn:ure:t6:occ:function:current-client:00821290","target_id":"urn:ure:t6:occ:function:current-client:004c0290"},{"id":"urn:ure:t6:occ:callsite:current-client:008212d8","call_va":"0x008212D8","target_va":"0x004CF090","section":".text","bytes":"e8b3ddcaff","caller_id":"urn:ure:t6:occ:function:current-client:00821290","target_id":"urn:ure:t6:occ:function:current-client:004cf090"},{"id":"urn:ure:t6:occ:callsite:current-client:008212f6","call_va":"0x008212F6","target_va":"0x0045D840","section":".text","bytes":"e845c5c3ff","caller_id":"urn:ure:t6:occ:function:current-client:008212f0","target_id":"urn:ure:t6:occ:function:current-client:0045d840"},{"id":"urn:ure:t6:occ:callsite:current-client:0082130a","call_va":"0x0082130A","target_va":"0x004C0290","section":".text","bytes":"e881efc9ff","caller_id":"urn:ure:t6:occ:function:current-client:008212f0","target_id":"urn:ure:t6:occ:function:current-client:004c0290"},{"id":"urn:ure:t6:occ:callsite:current-client:00821338","call_va":"0x00821338","target_va":"0x004CF090","section":".text","bytes":"e853ddcaff","caller_id":"urn:ure:t6:occ:function:current-client:008212f0","target_id":"urn:ure:t6:occ:function:current-client:004cf090"},{"id":"urn:ure:t6:occ:callsite:current-client:00821356","call_va":"0x00821356","target_va":"0x0045D840","section":".text","bytes":"e8e5c4c3ff","caller_id":"urn:ure:t6:occ:function:current-client:00821350","target_id":"urn:ure:t6:occ:function:current-client:0045d840"}] AS rows
