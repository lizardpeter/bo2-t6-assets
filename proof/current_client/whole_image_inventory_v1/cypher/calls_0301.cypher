id":"urn:ure:t6:occ:callsite:current-client:006eca36","call_va":"0x006ECA36","target_va":"0x00676310","section":".text","bytes":"e8d598f8ff","caller_id":"urn:ure:t6:occ:function:current-client:006eca00","target_id":"urn:ure:t6:occ:function:current-client:00676310"},{"id":"urn:ure:t6:occ:callsite:current-client:006eca64","call_va":"0x006ECA64","target_va":"0x00614D50","section":".text","bytes":"e8e782f2ff","caller_id":"urn:ure:t6:occ:function:current-client:006eca00","target_id":"urn:ure:t6:occ:function:current-client:00614d50"},{"id":"urn:ure:t6:occ:callsite:current-client:006ecb91","call_va":"0x006ECB91","target_va":"0x00676310","section":".text","bytes":"e87a97f8ff","caller_id":"urn:ure:t6:occ:function:current-client:006eca00","target_id":"urn:ure:t6:occ:function:current-client:00676310"},{"id":"urn:ure:t6:occ:callsite:current-client:006ecb9a","call_va":"0x006ECB9A","target_va":"0x006BCC60","section":".text","bytes":"e8c100fdff","caller_id":"urn:ure:t6:occ:function:current-client:006eca00","target_id":"urn:ure:t6:occ:function:current-client:006bcc60"},{"id":"urn:ure:t6:occ:callsite:current-client:006ece10","call_va":"0x006ECE10","target_va":"0x00685E00","section":".text","bytes":"e8eb8ff9ff","caller_id":"urn:ure:t6:occ:function:current-client:006ecdf0","target_id":"urn:ure:t6:occ:function:current-client:00685e00"},{"id":"urn:ure:t6:occ:callsite:current-client:006ece7b","call_va":"0x006ECE7B","target_va":"0x004D3CE0","section":".text","bytes":"e8606edeff","caller_id":"urn:ure:t6:occ:function:current-client:006ecdf0","target_id":"urn:ure:t6:occ:function:current-client:004d3ce0"}] AS rows
