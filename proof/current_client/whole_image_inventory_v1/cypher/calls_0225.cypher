id":"urn:ure:t6:occ:callsite:current-client:00628713","call_va":"0x00628713","target_va":"0x0091FFE0","section":".text","bytes":"e8c8782f00","caller_id":"urn:ure:t6:occ:function:current-client:006286b0","target_id":"urn:ure:t6:occ:function:current-client:0091ffe0"},{"id":"urn:ure:t6:occ:callsite:current-client:00628730","call_va":"0x00628730","target_va":"0x00593820","section":".text","bytes":"e8ebb0f6ff","caller_id":"urn:ure:t6:occ:function:current-client:006286b0","target_id":"urn:ure:t6:occ:function:current-client:00593820"},{"id":"urn:ure:t6:occ:callsite:current-client:0062873e","call_va":"0x0062873E","target_va":"0x00424F00","section":".text","bytes":"e8bdc7dfff","caller_id":"urn:ure:t6:occ:function:current-client:006286b0","target_id":"urn:ure:t6:occ:function:current-client:00424f00"},{"id":"urn:ure:t6:occ:callsite:current-client:006287ca","call_va":"0x006287CA","target_va":"0x0058E330","section":".text","bytes":"e8615bf6ff","caller_id":"urn:ure:t6:occ:function:current-client:006286b0","target_id":"urn:ure:t6:occ:function:current-client:0058e330"},{"id":"urn:ure:t6:occ:callsite:current-client:006287ff","call_va":"0x006287FF","target_va":"0x00483110","section":".text","bytes":"e80ca9e5ff","caller_id":"urn:ure:t6:occ:function:current-client:006287f0","target_id":"urn:ure:t6:occ:function:current-client:00483110"},{"id":"urn:ure:t6:occ:callsite:current-client:00628830","call_va":"0x00628830","target_va":"0x00630270","section":".text","bytes":"e83b7a0000","caller_id":"urn:ure:t6:occ:function:current-client:006287f0","target_id":"urn:ure:t6:occ:function:current-client:00630270"}] AS rows
