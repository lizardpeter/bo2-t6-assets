id":"urn:ure:t6:occ:callsite:current-client:00993073","call_va":"0x00993073","target_va":"0x00583BE0","section":".text","bytes":"e8680bbfff","caller_id":"urn:ure:t6:occ:function:current-client:0098eb50","target_id":"urn:ure:t6:occ:function:current-client:00583be0"},{"id":"urn:ure:t6:occ:callsite:current-client:00993082","call_va":"0x00993082","target_va":"0x00507BA0","section":".text","bytes":"e8194bb7ff","caller_id":"urn:ure:t6:occ:function:current-client:0098eb50","target_id":"urn:ure:t6:occ:function:current-client:00507ba0"},{"id":"urn:ure:t6:occ:callsite:current-client:0099309c","call_va":"0x0099309C","target_va":"0x0045A8E0","section":".text","bytes":"e83f78acff","caller_id":"urn:ure:t6:occ:function:current-client:0098eb50","target_id":"urn:ure:t6:occ:function:current-client:0045a8e0"},{"id":"urn:ure:t6:occ:callsite:current-client:009930b6","call_va":"0x009930B6","target_va":"0x00605250","section":".text","bytes":"e89521c7ff","caller_id":"urn:ure:t6:occ:function:current-client:0098eb50","target_id":"urn:ure:t6:occ:function:current-client:00605250"},{"id":"urn:ure:t6:occ:callsite:current-client:0099313a","call_va":"0x0099313A","target_va":"0x00583BE0","section":".text","bytes":"e8a10abfff","caller_id":"urn:ure:t6:occ:function:current-client:0098eb50","target_id":"urn:ure:t6:occ:function:current-client:00583be0"},{"id":"urn:ure:t6:occ:callsite:current-client:00993144","call_va":"0x00993144","target_va":"0x0045A8E0","section":".text","bytes":"e89777acff","caller_id":"urn:ure:t6:occ:function:current-client:0098eb50","target_id":"urn:ure:t6:occ:function:current-client:0045a8e0"}] AS rows
