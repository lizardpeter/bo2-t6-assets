id":"urn:ure:t6:occ:callsite:current-client:007b0959","call_va":"0x007B0959","target_va":"0x0044DFC0","section":".text","bytes":"e862d6c9ff","caller_id":"urn:ure:t6:occ:function:current-client:007b0950","target_id":"urn:ure:t6:occ:function:current-client:0044dfc0"},{"id":"urn:ure:t6:occ:callsite:current-client:007b096d","call_va":"0x007B096D","target_va":"0x005EA700","section":".text","bytes":"e88e9de3ff","caller_id":"urn:ure:t6:occ:function:current-client:007b0950","target_id":"urn:ure:t6:occ:function:current-client:005ea700"},{"id":"urn:ure:t6:occ:callsite:current-client:007b0985","call_va":"0x007B0985","target_va":"0x006F7570","section":".text","bytes":"e8e66bf4ff","caller_id":"urn:ure:t6:occ:function:current-client:007b0950","target_id":"urn:ure:t6:occ:function:current-client:006f7570"},{"id":"urn:ure:t6:occ:callsite:current-client:007b0995","call_va":"0x007B0995","target_va":"0x005EB560","section":".text","bytes":"e8c6abe3ff","caller_id":"urn:ure:t6:occ:function:current-client:007b0950","target_id":"urn:ure:t6:occ:function:current-client:005eb560"},{"id":"urn:ure:t6:occ:callsite:current-client:007b09b1","call_va":"0x007B09B1","target_va":"0x0044DFC0","section":".text","bytes":"e80ad6c9ff","caller_id":"urn:ure:t6:occ:function:current-client:007b0950","target_id":"urn:ure:t6:occ:function:current-client:0044dfc0"},{"id":"urn:ure:t6:occ:callsite:current-client:007b09ea","call_va":"0x007B09EA","target_va":"0x00482BF0","section":".text","bytes":"e80122cdff","caller_id":"urn:ure:t6:occ:function:current-client:007b0950","target_id":"urn:ure:t6:occ:function:current-client:00482bf0"}] AS rows
