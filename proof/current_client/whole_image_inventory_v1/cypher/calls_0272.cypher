id":"urn:ure:t6:occ:callsite:current-client:006a20ac","call_va":"0x006A20AC","target_va":"0x005B7610","section":".text","bytes":"e85f55f1ff","caller_id":"urn:ure:t6:occ:function:current-client:006a1db0","target_id":"urn:ure:t6:occ:function:current-client:005b7610"},{"id":"urn:ure:t6:occ:callsite:current-client:006a20c7","call_va":"0x006A20C7","target_va":"0x00A72F60","section":".text","bytes":"e8940e3d00","caller_id":"urn:ure:t6:occ:function:current-client:006a1db0","target_id":"urn:ure:t6:occ:function:current-client:00a72f60"},{"id":"urn:ure:t6:occ:callsite:current-client:006a20ef","call_va":"0x006A20EF","target_va":"0x005B7610","section":".text","bytes":"e81c55f1ff","caller_id":"urn:ure:t6:occ:function:current-client:006a1db0","target_id":"urn:ure:t6:occ:function:current-client:005b7610"},{"id":"urn:ure:t6:occ:callsite:current-client:006a210a","call_va":"0x006A210A","target_va":"0x00A72F60","section":".text","bytes":"e8510e3d00","caller_id":"urn:ure:t6:occ:function:current-client:006a1db0","target_id":"urn:ure:t6:occ:function:current-client:00a72f60"},{"id":"urn:ure:t6:occ:callsite:current-client:006a2131","call_va":"0x006A2131","target_va":"0x005B7610","section":".text","bytes":"e8da54f1ff","caller_id":"urn:ure:t6:occ:function:current-client:006a1db0","target_id":"urn:ure:t6:occ:function:current-client:005b7610"},{"id":"urn:ure:t6:occ:callsite:current-client:006a214f","call_va":"0x006A214F","target_va":"0x00A72F60","section":".text","bytes":"e80c0e3d00","caller_id":"urn:ure:t6:occ:function:current-client:006a1db0","target_id":"urn:ure:t6:occ:function:current-client:00a72f60"}] AS rows
