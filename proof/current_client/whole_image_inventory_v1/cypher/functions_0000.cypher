"0x004790D0",section:".text",basis:"direct-call-target",strongest_basis:"direct-call-target"},{id:"urn:ure:t6:occ:function:current-client:00479130",va:"0x00479130",section:".text",basis:"direct-call-target;post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:00479160",va:"0x00479160",section:".text",basis:"direct-call-target",strongest_basis:"direct-call-target"},{id:"urn:ure:t6:occ:function:current-client:004791a0",va:"0x004791A0",section:".text",basis:"direct-call-target;post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:004791d0",va:"0x004791D0",section:".text",basis:"direct-call-target",strongest_basis:"direct-call-target"},{id:"urn:ure:t6:occ:function:current-client:00479210",va:"0x00479210",section:".text",basis:"direct-call-target;post-int3-padding",strongest_basis:"post-int3-padding"}] AS rows
UNWIND rows AS row
MERGE (n:KGNode {id:row.id})
ON CREATE SET n._mechanical_inventory_new=true,
    n.kind='re:FunctionOccurrence', n.namespace='t6', n.build_id=b.id, n.artifact_id=a.id,
    n.display_name='sub_'+substring(row.va,2), n.address_space='va', n.address_start=row.va
SET n.entry_basis=row.basis, n.entry_strongest_basis=row.strongest_basis,
    n.boundary_state=CASE WHEN coalesce(n.boundary_state,'') STARTS WITH 'exact-' THEN n.boundary_state ELSE 'entry-only-mechanical-inventory' END,
    n.producer=CASE WHEN n.producer IS NULL THEN 't6-current-client-whole-image-mechanical-inventory-v1' ELSE n.producer END
WITH b,a,n,coalesce(n._mechanical_inventory_new,false) AS is_new
FOREACH (_ IN CASE WHEN is_new THEN [1] ELSE [] END |
  CREATE (b)-[:HAS_OCCURRENCE]->(n)
  CREATE (n)-[:DEFINED_IN]->(a)
)
REMOVE n._mechanical_inventory_new
