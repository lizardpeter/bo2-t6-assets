id":"urn:ure:t6:occ:callsite:current-client:004fd0fc","call_va":"0x004FD0FC","target_va":"0x0058FC30","section":".text","bytes":"e82f2b0900","caller_id":"urn:ure:t6:occ:function:current-client:004fd0c0","target_id":"urn:ure:t6:occ:function:current-client:0058fc30"},{"id":"urn:ure:t6:occ:callsite:current-client:004fd11d","call_va":"0x004FD11D","target_va":"0x0042E360","section":".text","bytes":"e83e12f3ff","caller_id":"urn:ure:t6:occ:function:current-client:004fd0c0","target_id":"urn:ure:t6:occ:function:current-client:0042e360"},{"id":"urn:ure:t6:occ:callsite:current-client:004fd145","call_va":"0x004FD145","target_va":"0x006D4170","section":".text","bytes":"e826701d00","caller_id":"urn:ure:t6:occ:function:current-client:004fd0c0","target_id":"urn:ure:t6:occ:function:current-client:006d4170"},{"id":"urn:ure:t6:occ:callsite:current-client:004fd17d","call_va":"0x004FD17D","target_va":"0x006D1A10","section":".text","bytes":"e88e481d00","caller_id":"urn:ure:t6:occ:function:current-client:004fd0c0","target_id":"urn:ure:t6:occ:function:current-client:006d1a10"},{"id":"urn:ure:t6:occ:callsite:current-client:004fd193","call_va":"0x004FD193","target_va":"0x00466280","section":".text","bytes":"e8e890f6ff","caller_id":"urn:ure:t6:occ:function:current-client:004fd0c0","target_id":"urn:ure:t6:occ:function:current-client:00466280"},{"id":"urn:ure:t6:occ:callsite:current-client:004fd1c3","call_va":"0x004FD1C3","target_va":"0x00424F00","section":".text","bytes":"e8387df2ff","caller_id":"urn:ure:t6:occ:function:current-client:004fd0c0","target_id":"urn:ure:t6:occ:function:current-client:00424f00"}] AS rows
