dding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:00980ef0",va:"0x00980EF0",section:".text",basis:"post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:00980fb0",va:"0x00980FB0",section:".text",basis:"post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:009810d0",va:"0x009810D0",section:".text",basis:"post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:009811a0",va:"0x009811A0",section:".text",basis:"post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:00981390",va:"0x00981390",section:".text",basis:"post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:00981700",va:"0x00981700",section:".text",basis:"post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:00981830",va:"0x00981830",section:".text",basis:"post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:009818a0",va:"0x009818A0",section:".text",basis:"post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:00981960",va:"0x00981960",section:".text",basis:"post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:00981a60",va:"0x00981A60",section:".text",basis:"post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:00981af0",va:"0x00981AF0",section:".text",basis:"post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:00981b80",va:"0x00981B80",section:".text",basis:"post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:00981e20",va:"0x00981E20",section:".text",basis:"direct-call-target;post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:00981ef0",va:"0x00981EF0",section:".text",basis:"direct-call-target;post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:00981f90",va:"0x00981F90",section:".text",basis:"direct-call-target;post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:009821b0",va:"0x009821B0",section:".text",basis:"post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:009823c0",va:"0x009823C0",section:".text",basis:"direct-call-target;post-int3-padding",strongest_basis:"post-int3-padding"}] AS rows
UNWIND rows AS row
MERGE (n:KGNode {id:row.id})
ON CREATE SET n._mechanical_inventory_new=true,
    n.kind='re:FunctionOccurrence', n.namespace='t6', n.build_id=b.id, n.artifact_id=a.id,
    n.display_name='sub_'+substring(row.va,2), n.address_space='va', n.address_start=row.va
SET n.entry_basis=row.basis, n.entry_strongest_basis=row.strongest_basis,
    n.boundary_state=CASE WHEN coalesce(n.boundary_state,'') STARTS WITH 'exact-' THEN n.boundary_state ELSE 'entry-only-mechanical-inventory' END,
    n.producer=CASE WHEN n.producer IS NULL THEN 't6-current-client-whole-image-mechanical-inventory-v1' ELSE n.producer END
WITH b,a,n,coalesce(n._mechanical_inventory_new,false) AS is_new
FOREACH (_ IN CASE WHEN is_new THEN [1] ELSE [] END |
  CREATE (b)-[:HAS_OCCURRENCE]->(n)
  CREATE (n)-[:DEFINED_IN]->(a)
)
REMOVE n._mechanical_inventory_new
