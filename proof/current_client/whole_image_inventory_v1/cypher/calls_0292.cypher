id":"urn:ure:t6:occ:callsite:current-client:006d58a9","call_va":"0x006D58A9","target_va":"0x0066FB90","section":".text","bytes":"e8e2a2f9ff","caller_id":"urn:ure:t6:occ:function:current-client:006d5820","target_id":"urn:ure:t6:occ:function:current-client:0066fb90"},{"id":"urn:ure:t6:occ:callsite:current-client:006d58d5","call_va":"0x006D58D5","target_va":"0x00517800","section":".text","bytes":"e8261fe4ff","caller_id":"urn:ure:t6:occ:function:current-client:006d58d0","target_id":"urn:ure:t6:occ:function:current-client:00517800"},{"id":"urn:ure:t6:occ:callsite:current-client:006d58e9","call_va":"0x006D58E9","target_va":"0x0068DD60","section":".text","bytes":"e87284fbff","caller_id":"urn:ure:t6:occ:function:current-client:006d58d0","target_id":"urn:ure:t6:occ:function:current-client:0068dd60"},{"id":"urn:ure:t6:occ:callsite:current-client:006d5916","call_va":"0x006D5916","target_va":"0x00520FE0","section":".text","bytes":"e8c5b6e4ff","caller_id":"urn:ure:t6:occ:function:current-client:006d5910","target_id":"urn:ure:t6:occ:function:current-client:00520fe0"},{"id":"urn:ure:t6:occ:callsite:current-client:006d5920","call_va":"0x006D5920","target_va":"0x006E37B0","section":".text","bytes":"e88bde0000","caller_id":"urn:ure:t6:occ:function:current-client:006d5910","target_id":"urn:ure:t6:occ:function:current-client:006e37b0"},{"id":"urn:ure:t6:occ:callsite:current-client:006d5963","call_va":"0x006D5963","target_va":"0x00682340","section":".text","bytes":"e8d8c9faff","caller_id":"urn:ure:t6:occ:function:current-client:006d5940","target_id":"urn:ure:t6:occ:function:current-client:00682340"}] AS rows
