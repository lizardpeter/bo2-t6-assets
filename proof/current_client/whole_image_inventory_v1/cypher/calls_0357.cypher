id":"urn:ure:t6:occ:callsite:current-client:007c1466","call_va":"0x007C1466","target_va":"0x00579130","section":".text","bytes":"e8c57cdbff","caller_id":"urn:ure:t6:occ:function:current-client:007c13a0","target_id":"urn:ure:t6:occ:function:current-client:00579130"},{"id":"urn:ure:t6:occ:callsite:current-client:007c148d","call_va":"0x007C148D","target_va":"0x00579130","section":".text","bytes":"e89e7cdbff","caller_id":"urn:ure:t6:occ:function:current-client:007c13a0","target_id":"urn:ure:t6:occ:function:current-client:00579130"},{"id":"urn:ure:t6:occ:callsite:current-client:007c14b1","call_va":"0x007C14B1","target_va":"0x00678620","section":".text","bytes":"e86a71ebff","caller_id":"urn:ure:t6:occ:function:current-client:007c14a0","target_id":"urn:ure:t6:occ:function:current-client:00678620"},{"id":"urn:ure:t6:occ:callsite:current-client:007c14d6","call_va":"0x007C14D6","target_va":"0x0044DFC0","section":".text","bytes":"e8e5cac8ff","caller_id":"urn:ure:t6:occ:function:current-client:007c14a0","target_id":"urn:ure:t6:occ:function:current-client:0044dfc0"},{"id":"urn:ure:t6:occ:callsite:current-client:007c14e9","call_va":"0x007C14E9","target_va":"0x0058FC30","section":".text","bytes":"e842e7dcff","caller_id":"urn:ure:t6:occ:function:current-client:007c14a0","target_id":"urn:ure:t6:occ:function:current-client:0058fc30"},{"id":"urn:ure:t6:occ:callsite:current-client:007c1512","call_va":"0x007C1512","target_va":"0x00403AE0","section":".text","bytes":"e8c925c4ff","caller_id":"urn:ure:t6:occ:function:current-client:007c14a0","target_id":"urn:ure:t6:occ:function:current-client:00403ae0"}] AS rows
