id":"urn:ure:t6:occ:callsite:current-client:0059ad8d","call_va":"0x0059AD8D","target_va":"0x005EFBA0","section":".text","bytes":"e80e4e0500","caller_id":"urn:ure:t6:occ:function:current-client:0059acb0","target_id":"urn:ure:t6:occ:function:current-client:005efba0"},{"id":"urn:ure:t6:occ:callsite:current-client:0059ada3","call_va":"0x0059ADA3","target_va":"0x005EFBA0","section":".text","bytes":"e8f84d0500","caller_id":"urn:ure:t6:occ:function:current-client:0059acb0","target_id":"urn:ure:t6:occ:function:current-client:005efba0"},{"id":"urn:ure:t6:occ:callsite:current-client:0059adc1","call_va":"0x0059ADC1","target_va":"0x00A7301A","section":".text","bytes":"e854824d00","caller_id":"urn:ure:t6:occ:function:current-client:0059acb0","target_id":"urn:ure:t6:occ:function:current-client:00a7301a"},{"id":"urn:ure:t6:occ:callsite:current-client:0059add3","call_va":"0x0059ADD3","target_va":"0x00A7301A","section":".text","bytes":"e842824d00","caller_id":"urn:ure:t6:occ:function:current-client:0059acb0","target_id":"urn:ure:t6:occ:function:current-client:00a7301a"},{"id":"urn:ure:t6:occ:callsite:current-client:0059ade3","call_va":"0x0059ADE3","target_va":"0x005EFBA0","section":".text","bytes":"e8b84d0500","caller_id":"urn:ure:t6:occ:function:current-client:0059acb0","target_id":"urn:ure:t6:occ:function:current-client:005efba0"},{"id":"urn:ure:t6:occ:callsite:current-client:0059adf9","call_va":"0x0059ADF9","target_va":"0x005EFBA0","section":".text","bytes":"e8a24d0500","caller_id":"urn:ure:t6:occ:function:current-client:0059acb0","target_id":"urn:ure:t6:occ:function:current-client:005efba0"}] AS rows
