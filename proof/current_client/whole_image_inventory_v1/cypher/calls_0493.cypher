id":"urn:ure:t6:occ:callsite:current-client:008f9907","call_va":"0x008F9907","target_va":"0x00580910","section":".text","bytes":"e80470c8ff","caller_id":"urn:ure:t6:occ:function:current-client:008f98b0","target_id":"urn:ure:t6:occ:function:current-client:00580910"},{"id":"urn:ure:t6:occ:callsite:current-client:008f996f","call_va":"0x008F996F","target_va":"0x00633170","section":".text","bytes":"e8fc97d3ff","caller_id":"urn:ure:t6:occ:function:current-client:008f9940","target_id":"urn:ure:t6:occ:function:current-client:00633170"},{"id":"urn:ure:t6:occ:callsite:current-client:008f9983","call_va":"0x008F9983","target_va":"0x00580910","section":".text","bytes":"e8886fc8ff","caller_id":"urn:ure:t6:occ:function:current-client:008f9940","target_id":"urn:ure:t6:occ:function:current-client:00580910"},{"id":"urn:ure:t6:occ:callsite:current-client:008f999b","call_va":"0x008F999B","target_va":"0x00633170","section":".text","bytes":"e8d097d3ff","caller_id":"urn:ure:t6:occ:function:current-client:008f9940","target_id":"urn:ure:t6:occ:function:current-client:00633170"},{"id":"urn:ure:t6:occ:callsite:current-client:008f99ab","call_va":"0x008F99AB","target_va":"0x00580910","section":".text","bytes":"e8606fc8ff","caller_id":"urn:ure:t6:occ:function:current-client:008f9940","target_id":"urn:ure:t6:occ:function:current-client:00580910"},{"id":"urn:ure:t6:occ:callsite:current-client:008f9a06","call_va":"0x008F9A06","target_va":"0x00633170","section":".text","bytes":"e86597d3ff","caller_id":"urn:ure:t6:occ:function:current-client:008f99e0","target_id":"urn:ure:t6:occ:function:current-client:00633170"}] AS rows
