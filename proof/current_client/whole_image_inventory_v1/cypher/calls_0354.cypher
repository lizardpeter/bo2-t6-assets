id":"urn:ure:t6:occ:callsite:current-client:007bda6b","call_va":"0x007BDA6B","target_va":"0x00618C90","section":".text","bytes":"e820b2e5ff","caller_id":"urn:ure:t6:occ:function:current-client:007bd5f0","target_id":"urn:ure:t6:occ:function:current-client:00618c90"},{"id":"urn:ure:t6:occ:callsite:current-client:007bda82","call_va":"0x007BDA82","target_va":"0x004F1650","section":".text","bytes":"e8c93bd3ff","caller_id":"urn:ure:t6:occ:function:current-client:007bd5f0","target_id":"urn:ure:t6:occ:function:current-client:004f1650"},{"id":"urn:ure:t6:occ:callsite:current-client:007bda91","call_va":"0x007BDA91","target_va":"0x00618C90","section":".text","bytes":"e8fab1e5ff","caller_id":"urn:ure:t6:occ:function:current-client:007bd5f0","target_id":"urn:ure:t6:occ:function:current-client:00618c90"},{"id":"urn:ure:t6:occ:callsite:current-client:007bdaa8","call_va":"0x007BDAA8","target_va":"0x004F1650","section":".text","bytes":"e8a33bd3ff","caller_id":"urn:ure:t6:occ:function:current-client:007bd5f0","target_id":"urn:ure:t6:occ:function:current-client:004f1650"},{"id":"urn:ure:t6:occ:callsite:current-client:007bdab7","call_va":"0x007BDAB7","target_va":"0x00618C90","section":".text","bytes":"e8d4b1e5ff","caller_id":"urn:ure:t6:occ:function:current-client:007bd5f0","target_id":"urn:ure:t6:occ:function:current-client:00618c90"},{"id":"urn:ure:t6:occ:callsite:current-client:007bdace","call_va":"0x007BDACE","target_va":"0x004F1650","section":".text","bytes":"e87d3bd3ff","caller_id":"urn:ure:t6:occ:function:current-client:007bd5f0","target_id":"urn:ure:t6:occ:function:current-client:004f1650"}] AS rows
