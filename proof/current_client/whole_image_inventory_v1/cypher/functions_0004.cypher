rn:ure:t6:occ:function:current-client:00649d60",va:"0x00649D60",section:".text",basis:"direct-call-target",strongest_basis:"direct-call-target"},{id:"urn:ure:t6:occ:function:current-client:00649d80",va:"0x00649D80",section:".text",basis:"direct-call-target",strongest_basis:"direct-call-target"},{id:"urn:ure:t6:occ:function:current-client:00649f50",va:"0x00649F50",section:".text",basis:"direct-call-target;post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:0064a000",va:"0x0064A000",section:".text",basis:"direct-call-target",strongest_basis:"direct-call-target"},{id:"urn:ure:t6:occ:function:current-client:0064a0a0",va:"0x0064A0A0",section:".text",basis:"post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:0064a1a0",va:"0x0064A1A0",section:".text",basis:"direct-call-target",strongest_basis:"direct-call-target"},{id:"urn:ure:t6:occ:function:current-client:0064a350",va:"0x0064A350",section:".text",basis:"direct-call-target;post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:0064a3e0",va:"0x0064A3E0",section:".text",basis:"direct-call-target;post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:0064a410",va:"0x0064A410",section:".text",basis:"direct-call-target;post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:0064a430",va:"0x0064A430",section:".text",basis:"post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:0064a490",va:"0x0064A490",section:".text",basis:"direct-call-target",strongest_basis:"direct-call-target"},{id:"urn:ure:t6:occ:function:current-client:0064a4b0",va:"0x0064A4B0",section:".text",basis:"direct-call-target;post-int3-padding",strongest_basis:"post-int3-padding"},{id:"urn:ure:t6:occ:function:current-client:0064a540",va:"0x0064A540",section:".text",basis:"direct-call-target",strongest_basis:"direct-call-target"},{id:"urn:ure:t6:occ:function:current-client:0064a5d0",va:"0x0064A5D0",section:".text",basis:"direct-call-target",strongest_basis:"direct-call-target"},{id:"urn:ure:t6:occ:function:current-client:0064a670",va:"0x0064A670",section:".text",basis:"direct-call-target;post-int3-padding",strongest_basis:"post-int3-padding"}] AS rows
UNWIND rows AS row
MERGE (n:KGNode {id:row.id})
ON CREATE SET n._mechanical_inventory_new=true,
    n.kind='re:FunctionOccurrence', n.namespace='t6', n.build_id=b.id, n.artifact_id=a.id,
    n.display_name='sub_'+substring(row.va,2), n.address_space='va', n.address_start=row.va
SET n.entry_basis=row.basis, n.entry_strongest_basis=row.strongest_basis,
    n.boundary_state=CASE WHEN coalesce(n.boundary_state,'') STARTS WITH 'exact-' THEN n.boundary_state ELSE 'entry-only-mechanical-inventory' END,
    n.producer=CASE WHEN n.producer IS NULL THEN 't6-current-client-whole-image-mechanical-inventory-v1' ELSE n.producer END
WITH b,a,n,coalesce(n._mechanical_inventory_new,false) AS is_new
FOREACH (_ IN CASE WHEN is_new THEN [1] ELSE [] END |
  CREATE (b)-[:HAS_OCCURRENCE]->(n)
  CREATE (n)-[:DEFINED_IN]->(a)
)
REMOVE n._mechanical_inventory_new
