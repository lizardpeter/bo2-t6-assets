id":"urn:ure:t6:occ:callsite:current-client:005e151e","call_va":"0x005E151E","target_va":"0x005078C0","section":".text","bytes":"e89d63f2ff","caller_id":"urn:ure:t6:occ:function:current-client:005e13c0","target_id":"urn:ure:t6:occ:function:current-client:005078c0"},{"id":"urn:ure:t6:occ:callsite:current-client:005e153c","call_va":"0x005E153C","target_va":"0x005078C0","section":".text","bytes":"e87f63f2ff","caller_id":"urn:ure:t6:occ:function:current-client:005e13c0","target_id":"urn:ure:t6:occ:function:current-client:005078c0"},{"id":"urn:ure:t6:occ:callsite:current-client:005e155c","call_va":"0x005E155C","target_va":"0x005078C0","section":".text","bytes":"e85f63f2ff","caller_id":"urn:ure:t6:occ:function:current-client:005e13c0","target_id":"urn:ure:t6:occ:function:current-client:005078c0"},{"id":"urn:ure:t6:occ:callsite:current-client:005e1578","call_va":"0x005E1578","target_va":"0x005078C0","section":".text","bytes":"e84363f2ff","caller_id":"urn:ure:t6:occ:function:current-client:005e13c0","target_id":"urn:ure:t6:occ:function:current-client:005078c0"},{"id":"urn:ure:t6:occ:callsite:current-client:005e1598","call_va":"0x005E1598","target_va":"0x005078C0","section":".text","bytes":"e82363f2ff","caller_id":"urn:ure:t6:occ:function:current-client:005e13c0","target_id":"urn:ure:t6:occ:function:current-client:005078c0"},{"id":"urn:ure:t6:occ:callsite:current-client:005e15af","call_va":"0x005E15AF","target_va":"0x005078C0","section":".text","bytes":"e80c63f2ff","caller_id":"urn:ure:t6:occ:function:current-client:005e13c0","target_id":"urn:ure:t6:occ:function:current-client:005078c0"}] AS rows
