id":"urn:ure:t6:occ:callsite:current-client:00978a55","call_va":"0x00978A55","target_va":"0x0065A580","section":".text","bytes":"e8261bceff","caller_id":"urn:ure:t6:occ:function:current-client:009789a0","target_id":"urn:ure:t6:occ:function:current-client:0065a580"},{"id":"urn:ure:t6:occ:callsite:current-client:00978a75","call_va":"0x00978A75","target_va":"0x0050BFC0","section":".text","bytes":"e84635b9ff","caller_id":"urn:ure:t6:occ:function:current-client:00978a70","target_id":"urn:ure:t6:occ:function:current-client:0050bfc0"},{"id":"urn:ure:t6:occ:callsite:current-client:00978aa1","call_va":"0x00978AA1","target_va":"0x004D5030","section":".text","bytes":"e88ac5b5ff","caller_id":"urn:ure:t6:occ:function:current-client:00978a90","target_id":"urn:ure:t6:occ:function:current-client:004d5030"},{"id":"urn:ure:t6:occ:callsite:current-client:00978ab4","call_va":"0x00978AB4","target_va":"0x00682340","section":".text","bytes":"e88798d0ff","caller_id":"urn:ure:t6:occ:function:current-client:00978a90","target_id":"urn:ure:t6:occ:function:current-client:00682340"},{"id":"urn:ure:t6:occ:callsite:current-client:00978abe","call_va":"0x00978ABE","target_va":"0x004D5030","section":".text","bytes":"e86dc5b5ff","caller_id":"urn:ure:t6:occ:function:current-client:00978a90","target_id":"urn:ure:t6:occ:function:current-client:004d5030"},{"id":"urn:ure:t6:occ:callsite:current-client:00978aec","call_va":"0x00978AEC","target_va":"0x005FB2F0","section":".text","bytes":"e8ff27c8ff","caller_id":"urn:ure:t6:occ:function:current-client:00978a90","target_id":"urn:ure:t6:occ:function:current-client:005fb2f0"}] AS rows
