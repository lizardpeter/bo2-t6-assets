id":"urn:ure:t6:occ:callsite:current-client:007f37d6","call_va":"0x007F37D6","target_va":"0x005D85B0","section":".text","bytes":"e8d54ddeff","caller_id":"urn:ure:t6:occ:function:current-client:007f3790","target_id":"urn:ure:t6:occ:function:current-client:005d85b0"},{"id":"urn:ure:t6:occ:callsite:current-client:007f37de","call_va":"0x007F37DE","target_va":"0x005BE760","section":".text","bytes":"e87dafdcff","caller_id":"urn:ure:t6:occ:function:current-client:007f3790","target_id":"urn:ure:t6:occ:function:current-client:005be760"},{"id":"urn:ure:t6:occ:callsite:current-client:007f37f9","call_va":"0x007F37F9","target_va":"0x0057CA90","section":".text","bytes":"e89292d8ff","caller_id":"urn:ure:t6:occ:function:current-client:007f3790","target_id":"urn:ure:t6:occ:function:current-client:0057ca90"},{"id":"urn:ure:t6:occ:callsite:current-client:007f3812","call_va":"0x007F3812","target_va":"0x0057EC40","section":".text","bytes":"e829b4d8ff","caller_id":"urn:ure:t6:occ:function:current-client:007f3790","target_id":"urn:ure:t6:occ:function:current-client:0057ec40"},{"id":"urn:ure:t6:occ:callsite:current-client:007f3847","call_va":"0x007F3847","target_va":"0x006EE880","section":".text","bytes":"e834b0efff","caller_id":"urn:ure:t6:occ:function:current-client:007f3790","target_id":"urn:ure:t6:occ:function:current-client:006ee880"},{"id":"urn:ure:t6:occ:callsite:current-client:007f3884","call_va":"0x007F3884","target_va":"0x007F2B00","section":".text","bytes":"e877f2ffff","caller_id":"urn:ure:t6:occ:function:current-client:007f3790","target_id":"urn:ure:t6:occ:function:current-client:007f2b00"}] AS rows
