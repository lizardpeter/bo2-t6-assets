id":"urn:ure:t6:occ:callsite:current-client:005e6ff2","call_va":"0x005E6FF2","target_va":"0x0062A790","section":".text","bytes":"e899370400","caller_id":"urn:ure:t6:occ:function:current-client:005e6fd0","target_id":"urn:ure:t6:occ:function:current-client:0062a790"},{"id":"urn:ure:t6:occ:callsite:current-client:005e7006","call_va":"0x005E7006","target_va":"0x00576B90","section":".text","bytes":"e885fbf8ff","caller_id":"urn:ure:t6:occ:function:current-client:005e6fd0","target_id":"urn:ure:t6:occ:function:current-client:00576b90"},{"id":"urn:ure:t6:occ:callsite:current-client:005e7013","call_va":"0x005E7013","target_va":"0x0044EB30","section":".text","bytes":"e8187be6ff","caller_id":"urn:ure:t6:occ:function:current-client:005e6fd0","target_id":"urn:ure:t6:occ:function:current-client:0044eb30"},{"id":"urn:ure:t6:occ:callsite:current-client:005e7020","call_va":"0x005E7020","target_va":"0x0055C990","section":".text","bytes":"e86b59f7ff","caller_id":"urn:ure:t6:occ:function:current-client:005e6fd0","target_id":"urn:ure:t6:occ:function:current-client:0055c990"},{"id":"urn:ure:t6:occ:callsite:current-client:005e7069","call_va":"0x005E7069","target_va":"0x00628C20","section":".text","bytes":"e8b21b0400","caller_id":"urn:ure:t6:occ:function:current-client:005e7060","target_id":"urn:ure:t6:occ:function:current-client:00628c20"},{"id":"urn:ure:t6:occ:callsite:current-client:005e7086","call_va":"0x005E7086","target_va":"0x0044DFC0","section":".text","bytes":"e8356fe6ff","caller_id":"urn:ure:t6:occ:function:current-client:005e7080","target_id":"urn:ure:t6:occ:function:current-client:0044dfc0"}] AS rows
