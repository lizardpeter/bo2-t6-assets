id":"urn:ure:t6:occ:callsite:current-client:005b436a","call_va":"0x005B436A","target_va":"0x005F14F0","section":".text","bytes":"e881d10300","caller_id":"urn:ure:t6:occ:function:current-client:005b42f0","target_id":"urn:ure:t6:occ:function:current-client:005f14f0"},{"id":"urn:ure:t6:occ:callsite:current-client:005b439c","call_va":"0x005B439C","target_va":"0x0044DFC0","section":".text","bytes":"e81f9ce9ff","caller_id":"urn:ure:t6:occ:function:current-client:005b4380","target_id":"urn:ure:t6:occ:function:current-client:0044dfc0"},{"id":"urn:ure:t6:occ:callsite:current-client:005b43ff","call_va":"0x005B43FF","target_va":"0x00799E50","section":".text","bytes":"e84c5a1e00","caller_id":"urn:ure:t6:occ:function:current-client:005b4380","target_id":"urn:ure:t6:occ:function:current-client:00799e50"},{"id":"urn:ure:t6:occ:callsite:current-client:005b4419","call_va":"0x005B4419","target_va":"0x005C35B0","section":".text","bytes":"e892f10000","caller_id":"urn:ure:t6:occ:function:current-client:005b4410","target_id":"urn:ure:t6:occ:function:current-client:005c35b0"},{"id":"urn:ure:t6:occ:callsite:current-client:005b4427","call_va":"0x005B4427","target_va":"0x004645D0","section":".text","bytes":"e8a401ebff","caller_id":"urn:ure:t6:occ:function:current-client:005b4410","target_id":"urn:ure:t6:occ:function:current-client:004645d0"},{"id":"urn:ure:t6:occ:callsite:current-client:005b443a","call_va":"0x005B443A","target_va":"0x00405F40","section":".text","bytes":"e8011be5ff","caller_id":"urn:ure:t6:occ:function:current-client:005b4410","target_id":"urn:ure:t6:occ:function:current-client:00405f40"}] AS rows
