id":"urn:ure:t6:occ:callsite:current-client:004bf7f0","call_va":"0x004BF7F0","target_va":"0x00415A30","section":".text","bytes":"e83b62f5ff","caller_id":"urn:ure:t6:occ:function:current-client:004bf6e0","target_id":"urn:ure:t6:occ:function:current-client:00415a30"},{"id":"urn:ure:t6:occ:callsite:current-client:004bf804","call_va":"0x004BF804","target_va":"0x00673040","section":".text","bytes":"e837381b00","caller_id":"urn:ure:t6:occ:function:current-client:004bf6e0","target_id":"urn:ure:t6:occ:function:current-client:00673040"},{"id":"urn:ure:t6:occ:callsite:current-client:004bf80c","call_va":"0x004BF80C","target_va":"0x004F1650","section":".text","bytes":"e83f1e0300","caller_id":"urn:ure:t6:occ:function:current-client:004bf6e0","target_id":"urn:ure:t6:occ:function:current-client:004f1650"},{"id":"urn:ure:t6:occ:callsite:current-client:004bf820","call_va":"0x004BF820","target_va":"0x004F1650","section":".text","bytes":"e82b1e0300","caller_id":"urn:ure:t6:occ:function:current-client:004bf6e0","target_id":"urn:ure:t6:occ:function:current-client:004f1650"},{"id":"urn:ure:t6:occ:callsite:current-client:004bf85e","call_va":"0x004BF85E","target_va":"0x00A73D6D","section":".text","bytes":"e80a455b00","caller_id":"urn:ure:t6:occ:function:current-client:004bf830","target_id":"urn:ure:t6:occ:function:current-client:00a73d6d"},{"id":"urn:ure:t6:occ:callsite:current-client:004bf886","call_va":"0x004BF886","target_va":"0x0044DFC0","section":".text","bytes":"e835e7f8ff","caller_id":"urn:ure:t6:occ:function:current-client:004bf880","target_id":"urn:ure:t6:occ:function:current-client:0044dfc0"}] AS rows
UNWIND rows AS row
MATCH (target:KGNode {id:row.target_id})
MERGE (c:KGNode {id:row.id})
SET c.kind='core:Occurrence', c.occurrence_type='direct-callsite', c.namespace='t6', c.build_id=b.id, c.artifact_id=a.id,
    c.address_space='va', c.address_start=row.call_va, c.target_va=row.target_va, c.section_name=row.section,
