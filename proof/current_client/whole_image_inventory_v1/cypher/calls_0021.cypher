llsite:current-client:00619658",call_va:"0x00619658",target_va:"0x0068A310",section:".text",bytes:"e8b30c0700",caller_id:"urn:ure:t6:occ:function:current-client:00618f40",target_id:"urn:ure:t6:occ:function:current-client:0068a310"},{id:"urn:ure:t6:occ:callsite:current-client:00619662",call_va:"0x00619662",target_va:"0x0068A310",section:".text",bytes:"e8a90c0700",caller_id:"urn:ure:t6:occ:function:current-client:00618f40",target_id:"urn:ure:t6:occ:function:current-client:0068a310"},{id:"urn:ure:t6:occ:callsite:current-client:0061966f",call_va:"0x0061966F",target_va:"0x00556B90",section:".text",bytes:"e81cd5f3ff",caller_id:"urn:ure:t6:occ:function:current-client:00618f40",target_id:"urn:ure:t6:occ:function:current-client:00556b90"},{id:"urn:ure:t6:occ:callsite:current-client:0061967b",call_va:"0x0061967B",target_va:"0x005EB560",section:".text",bytes:"e8e01efdff",caller_id:"urn:ure:t6:occ:function:current-client:00618f40",target_id:"urn:ure:t6:occ:function:current-client:005eb560"},{id:"urn:ure:t6:occ:callsite:current-client:00619685",call_va:"0x00619685",target_va:"0x0057AE30",section:".text",bytes:"e8a617f6ff",caller_id:"urn:ure:t6:occ:function:current-client:00618f40",target_id:"urn:ure:t6:occ:function:current-client:0057ae30"},{id:"urn:ure:t6:occ:callsite:current-client:0061968e",call_va:"0x0061968E",target_va:"0x00556B90",section:".text",bytes:"e8fdd4f3ff",caller_id:"urn:ure:t6:occ:function:current-client:00618f40",target_id:"urn:ure:t6:occ:function:current-client:00556b90"},{id:"urn:ure:t6:occ:callsite:current-client:0061969e",call_va:"0x0061969E",target_va:"0x005EB560",section:".text",bytes:"e8bd1efdff",caller_id:"urn:ure:t6:occ:function:current-client:00618f40",target_id:"urn:ure:t6:occ:function:current-client:005eb560"},{id:"urn:ure:t6:occ:callsite:current-client:006196a9",call_va:"0x006196A9",target_va:"0x006FD620",section:".text",bytes:"e8723f0e00",caller_id:"urn:ure:t6:occ:function:current-client:00618f40",target_id:"urn:ure:t6:occ:function:current-client:006fd620"}] AS rows
UNWIND rows AS row
MATCH (target:KGNode {id:row.target_id})
MERGE (c:KGNode {id:row.id})
ON CREATE SET c._mechanical_inventory_new=true
SET c.kind='core:Occurrence', c.occurrence_type='direct-callsite', c.namespace='t6', c.build_id=b.id, c.artifact_id=a.id,
    c.address_space='va', c.address_start=row.call_va, c.target_va=row.target_va, c.section_name=row.section,
    c.instruction_bytes=row.bytes, c.caller_assignment_state=CASE WHEN row.caller_id IS NULL THEN 'unassigned' ELSE 'nearest-preceding-entry-candidate' END,
    c.producer='t6-current-client-whole-image-mechanical-inventory-v1'
WITH b,a,row,target,c,coalesce(c._mechanical_inventory_new,false) AS is_new
OPTIONAL MATCH (caller:KGNode {id:row.caller_id})
FOREACH (_ IN CASE WHEN is_new THEN [1] ELSE [] END |
  CREATE (b)-[:HAS_OCCURRENCE]->(c)
  CREATE (c)-[:DEFINED_IN]->(a)
  CREATE (c)-[:CALLS_TARGET]->(target)
)
FOREACH (_ IN CASE WHEN is_new AND caller IS NOT NULL THEN [1] ELSE [] END |
  CREATE (caller)-[:HAS_CALLSITE]->(c)
)
REMOVE c._mechanical_inventory_new
