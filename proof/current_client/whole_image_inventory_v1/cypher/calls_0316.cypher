id":"urn:ure:t6:occ:callsite:current-client:0071c6b7","call_va":"0x0071C6B7","target_va":"0x004445C0","section":".text","bytes":"e8047fd2ff","caller_id":"urn:ure:t6:occ:function:current-client:00718c20","target_id":"urn:ure:t6:occ:function:current-client:004445c0"},{"id":"urn:ure:t6:occ:callsite:current-client:0071c6fa","call_va":"0x0071C6FA","target_va":"0x004445C0","section":".text","bytes":"e8c17ed2ff","caller_id":"urn:ure:t6:occ:function:current-client:00718c20","target_id":"urn:ure:t6:occ:function:current-client:004445c0"},{"id":"urn:ure:t6:occ:callsite:current-client:0071c735","call_va":"0x0071C735","target_va":"0x004445C0","section":".text","bytes":"e8867ed2ff","caller_id":"urn:ure:t6:occ:function:current-client:00718c20","target_id":"urn:ure:t6:occ:function:current-client:004445c0"},{"id":"urn:ure:t6:occ:callsite:current-client:0071c770","call_va":"0x0071C770","target_va":"0x004445C0","section":".text","bytes":"e84b7ed2ff","caller_id":"urn:ure:t6:occ:function:current-client:00718c20","target_id":"urn:ure:t6:occ:function:current-client:004445c0"},{"id":"urn:ure:t6:occ:callsite:current-client:0071c78b","call_va":"0x0071C78B","target_va":"0x004E0170","section":".text","bytes":"e8e039dcff","caller_id":"urn:ure:t6:occ:function:current-client:00718c20","target_id":"urn:ure:t6:occ:function:current-client:004e0170"},{"id":"urn:ure:t6:occ:callsite:current-client:0071c7d3","call_va":"0x0071C7D3","target_va":"0x004445C0","section":".text","bytes":"e8e87dd2ff","caller_id":"urn:ure:t6:occ:function:current-client:00718c20","target_id":"urn:ure:t6:occ:function:current-client:004445c0"}] AS rows
