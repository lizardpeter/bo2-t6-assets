id":"urn:ure:t6:occ:callsite:current-client:004e16fe","call_va":"0x004E16FE","target_va":"0x00A7301A","section":".text","bytes":"e817195900","caller_id":"urn:ure:t6:occ:function:current-client:004e16c0","target_id":"urn:ure:t6:occ:function:current-client:00a7301a"},{"id":"urn:ure:t6:occ:callsite:current-client:004e172e","call_va":"0x004E172E","target_va":"0x00872CE0","section":".text","bytes":"e8ad153900","caller_id":"urn:ure:t6:occ:function:current-client:004e16c0","target_id":"urn:ure:t6:occ:function:current-client:00872ce0"},{"id":"urn:ure:t6:occ:callsite:current-client:004e1746","call_va":"0x004E1746","target_va":"0x00662B90","section":".text","bytes":"e845141800","caller_id":"urn:ure:t6:occ:function:current-client:004e16c0","target_id":"urn:ure:t6:occ:function:current-client:00662b90"},{"id":"urn:ure:t6:occ:callsite:current-client:004e177a","call_va":"0x004E177A","target_va":"0x00701590","section":".text","bytes":"e811fe2100","caller_id":"urn:ure:t6:occ:function:current-client:004e1770","target_id":"urn:ure:t6:occ:function:current-client:00701590"},{"id":"urn:ure:t6:occ:callsite:current-client:004e17fc","call_va":"0x004E17FC","target_va":"0x005759A0","section":".text","bytes":"e89f410900","caller_id":"urn:ure:t6:occ:function:current-client:004e1770","target_id":"urn:ure:t6:occ:function:current-client:005759a0"},{"id":"urn:ure:t6:occ:callsite:current-client:004e1828","call_va":"0x004E1828","target_va":"0x005E36C0","section":".text","bytes":"e8931e1000","caller_id":"urn:ure:t6:occ:function:current-client:004e1770","target_id":"urn:ure:t6:occ:function:current-client:005e36c0"}] AS rows
