id":"urn:ure:t6:occ:callsite:current-client:005d8f74","call_va":"0x005D8F74","target_va":"0x0054F480","section":".text","bytes":"e80765f7ff","caller_id":"urn:ure:t6:occ:function:current-client:005d8ee0","target_id":"urn:ure:t6:occ:function:current-client:0054f480"},{"id":"urn:ure:t6:occ:callsite:current-client:005d8f7c","call_va":"0x005D8F7C","target_va":"0x00603AB0","section":".text","bytes":"e82fab0200","caller_id":"urn:ure:t6:occ:function:current-client:005d8ee0","target_id":"urn:ure:t6:occ:function:current-client:00603ab0"},{"id":"urn:ure:t6:occ:callsite:current-client:005d8f9f","call_va":"0x005D8F9F","target_va":"0x005FB520","section":".text","bytes":"e87c250200","caller_id":"urn:ure:t6:occ:function:current-client:005d8f90","target_id":"urn:ure:t6:occ:function:current-client:005fb520"},{"id":"urn:ure:t6:occ:callsite:current-client:005d8fae","call_va":"0x005D8FAE","target_va":"0x00A45740","section":".text","bytes":"e88dc74600","caller_id":"urn:ure:t6:occ:function:current-client:005d8f90","target_id":"urn:ure:t6:occ:function:current-client:00a45740"},{"id":"urn:ure:t6:occ:callsite:current-client:005d8fbf","call_va":"0x005D8FBF","target_va":"0x00A45960","section":".text","bytes":"e89cc94600","caller_id":"urn:ure:t6:occ:function:current-client:005d8f90","target_id":"urn:ure:t6:occ:function:current-client:00a45960"},{"id":"urn:ure:t6:occ:callsite:current-client:005d8fca","call_va":"0x005D8FCA","target_va":"0x00A457C0","section":".text","bytes":"e8f1c74600","caller_id":"urn:ure:t6:occ:function:current-client:005d8f90","target_id":"urn:ure:t6:occ:function:current-client:00a457c0"}] AS rows
