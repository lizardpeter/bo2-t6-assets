id":"urn:ure:t6:occ:callsite:current-client:007cf2b1","call_va":"0x007CF2B1","target_va":"0x00593820","section":".text","bytes":"e86a45dcff","caller_id":"urn:ure:t6:occ:function:current-client:007cf040","target_id":"urn:ure:t6:occ:function:current-client:00593820"},{"id":"urn:ure:t6:occ:callsite:current-client:007cf2bc","call_va":"0x007CF2BC","target_va":"0x00403AE0","section":".text","bytes":"e81f48c3ff","caller_id":"urn:ure:t6:occ:function:current-client:007cf040","target_id":"urn:ure:t6:occ:function:current-client:00403ae0"},{"id":"urn:ure:t6:occ:callsite:current-client:007cf2cc","call_va":"0x007CF2CC","target_va":"0x0067C6A0","section":".text","bytes":"e8cfd3eaff","caller_id":"urn:ure:t6:occ:function:current-client:007cf040","target_id":"urn:ure:t6:occ:function:current-client:0067c6a0"},{"id":"urn:ure:t6:occ:callsite:current-client:007cf2d7","call_va":"0x007CF2D7","target_va":"0x00633400","section":".text","bytes":"e82441e6ff","caller_id":"urn:ure:t6:occ:function:current-client:007cf040","target_id":"urn:ure:t6:occ:function:current-client:00633400"},{"id":"urn:ure:t6:occ:callsite:current-client:007cf332","call_va":"0x007CF332","target_va":"0x00593820","section":".text","bytes":"e8e944dcff","caller_id":"urn:ure:t6:occ:function:current-client:007cf040","target_id":"urn:ure:t6:occ:function:current-client:00593820"},{"id":"urn:ure:t6:occ:callsite:current-client:007cf33c","call_va":"0x007CF33C","target_va":"0x00415A30","section":".text","bytes":"e8ef66c4ff","caller_id":"urn:ure:t6:occ:function:current-client:007cf040","target_id":"urn:ure:t6:occ:function:current-client:00415a30"}] AS rows
UNWIND rows AS row
MATCH (target:KGNode {id:row.target_id})
MERGE (c:KGNode {id:row.id})
SET c.kind='core:Occurrence', c.occurrence_type='direct-callsite', c.namespace='t6', c.build_id=b.id, c.artifact_id=a.id,
    c.address_space='va', c.address_start=row.call_va, c.target_va=row.target_va, c.section_name=row.section,
    c.instruction_bytes=row.bytes, c.caller_assignment_state=CASE WHEN row.caller_id IS NULL THEN 'unassigned' ELSE 'nearest-preceding-entry-candidate' END,
    c.producer='t6-current-client-whole-image-mechanical-inventory-v1'
MERGE (b)-[:HAS_OCCURRENCE]->(c)
MERGE (c)-[:DEFINED_IN]->(a)
MERGE (c)-[:CALLS_TARGET]->(target)
FOREACH (_ IN CASE WHEN row.caller_id IS NULL THEN [] ELSE [1] END |
  MERGE (caller:KGNode {id:row.caller_id})
  MERGE (caller)-[:HAS_CALLSITE]->(c)
)
