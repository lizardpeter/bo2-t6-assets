id":"urn:ure:t6:occ:callsite:current-client:008b2695","call_va":"0x008B2695","target_va":"0x008B0540","section":".text","bytes":"e8a6deffff","caller_id":"urn:ure:t6:occ:function:current-client:008b2680","target_id":"urn:ure:t6:occ:function:current-client:008b0540"},{"id":"urn:ure:t6:occ:callsite:current-client:008b26b8","call_va":"0x008B26B8","target_va":"0x008B0540","section":".text","bytes":"e883deffff","caller_id":"urn:ure:t6:occ:function:current-client:008b2680","target_id":"urn:ure:t6:occ:function:current-client:008b0540"},{"id":"urn:ure:t6:occ:callsite:current-client:008b26cd","call_va":"0x008B26CD","target_va":"0x008AE7C0","section":".text","bytes":"e8eec0ffff","caller_id":"urn:ure:t6:occ:function:current-client:008b2680","target_id":"urn:ure:t6:occ:function:current-client:008ae7c0"},{"id":"urn:ure:t6:occ:callsite:current-client:008b26d3","call_va":"0x008B26D3","target_va":"0x004FA970","section":".text","bytes":"e89882c4ff","caller_id":"urn:ure:t6:occ:function:current-client:008b2680","target_id":"urn:ure:t6:occ:function:current-client:004fa970"},{"id":"urn:ure:t6:occ:callsite:current-client:008b26ea","call_va":"0x008B26EA","target_va":"0x008B0470","section":".text","bytes":"e881ddffff","caller_id":"urn:ure:t6:occ:function:current-client:008b2680","target_id":"urn:ure:t6:occ:function:current-client:008b0470"},{"id":"urn:ure:t6:occ:callsite:current-client:008b270d","call_va":"0x008B270D","target_va":"0x008AE7C0","section":".text","bytes":"e8aec0ffff","caller_id":"urn:ure:t6:occ:function:current-client:008b2700","target_id":"urn:ure:t6:occ:function:current-client:008ae7c0"}] AS rows
