id":"urn:ure:t6:occ:callsite:current-client:00551049","call_va":"0x00551049","target_va":"0x00546400","section":".text","bytes":"e8b253ffff","caller_id":"urn:ure:t6:occ:function:current-client:00550850","target_id":"urn:ure:t6:occ:function:current-client:00546400"},{"id":"urn:ure:t6:occ:callsite:current-client:00551062","call_va":"0x00551062","target_va":"0x005C6F10","section":".text","bytes":"e8a95e0700","caller_id":"urn:ure:t6:occ:function:current-client:00550850","target_id":"urn:ure:t6:occ:function:current-client:005c6f10"},{"id":"urn:ure:t6:occ:callsite:current-client:0055107c","call_va":"0x0055107C","target_va":"0x00546400","section":".text","bytes":"e87f53ffff","caller_id":"urn:ure:t6:occ:function:current-client:00550850","target_id":"urn:ure:t6:occ:function:current-client:00546400"},{"id":"urn:ure:t6:occ:callsite:current-client:00551095","call_va":"0x00551095","target_va":"0x005C6F10","section":".text","bytes":"e8765e0700","caller_id":"urn:ure:t6:occ:function:current-client:00550850","target_id":"urn:ure:t6:occ:function:current-client:005c6f10"},{"id":"urn:ure:t6:occ:callsite:current-client:005510af","call_va":"0x005510AF","target_va":"0x00546400","section":".text","bytes":"e84c53ffff","caller_id":"urn:ure:t6:occ:function:current-client:00550850","target_id":"urn:ure:t6:occ:function:current-client:00546400"},{"id":"urn:ure:t6:occ:callsite:current-client:005510c8","call_va":"0x005510C8","target_va":"0x005C6F10","section":".text","bytes":"e8435e0700","caller_id":"urn:ure:t6:occ:function:current-client:00550850","target_id":"urn:ure:t6:occ:function:current-client:005c6f10"}] AS rows
