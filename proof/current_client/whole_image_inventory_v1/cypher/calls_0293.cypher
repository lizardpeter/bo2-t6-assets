id":"urn:ure:t6:occ:callsite:current-client:006d7514","call_va":"0x006D7514","target_va":"0x00593820","section":".text","bytes":"e807c3ebff","caller_id":"urn:ure:t6:occ:function:current-client:006d73f0","target_id":"urn:ure:t6:occ:function:current-client:00593820"},{"id":"urn:ure:t6:occ:callsite:current-client:006d753b","call_va":"0x006D753B","target_va":"0x00622760","section":".text","bytes":"e820b2f4ff","caller_id":"urn:ure:t6:occ:function:current-client:006d73f0","target_id":"urn:ure:t6:occ:function:current-client:00622760"},{"id":"urn:ure:t6:occ:callsite:current-client:006d759e","call_va":"0x006D759E","target_va":"0x00441470","section":".text","bytes":"e8cd9ed6ff","caller_id":"urn:ure:t6:occ:function:current-client:006d7570","target_id":"urn:ure:t6:occ:function:current-client:00441470"},{"id":"urn:ure:t6:occ:callsite:current-client:006d75c9","call_va":"0x006D75C9","target_va":"0x0046B2E0","section":".text","bytes":"e8123dd9ff","caller_id":"urn:ure:t6:occ:function:current-client:006d7570","target_id":"urn:ure:t6:occ:function:current-client:0046b2e0"},{"id":"urn:ure:t6:occ:callsite:current-client:006d75e1","call_va":"0x006D75E1","target_va":"0x005C0DD0","section":".text","bytes":"e8ea97eeff","caller_id":"urn:ure:t6:occ:function:current-client:006d7570","target_id":"urn:ure:t6:occ:function:current-client:005c0dd0"},{"id":"urn:ure:t6:occ:callsite:current-client:006d762d","call_va":"0x006D762D","target_va":"0x005A6B50","section":".text","bytes":"e81ef5ecff","caller_id":"urn:ure:t6:occ:function:current-client:006d7570","target_id":"urn:ure:t6:occ:function:current-client:005a6b50"}] AS rows
