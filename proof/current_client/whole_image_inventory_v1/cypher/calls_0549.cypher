id":"urn:ure:t6:occ:callsite:current-client:00979d2d","call_va":"0x00979D2D","target_va":"0x006AD580","section":".text","bytes":"e84e38d3ff","caller_id":"urn:ure:t6:occ:function:current-client:00979b20","target_id":"urn:ure:t6:occ:function:current-client:006ad580"},{"id":"urn:ure:t6:occ:callsite:current-client:00979d4a","call_va":"0x00979D4A","target_va":"0x005FB2F0","section":".text","bytes":"e8a115c8ff","caller_id":"urn:ure:t6:occ:function:current-client:00979b20","target_id":"urn:ure:t6:occ:function:current-client:005fb2f0"},{"id":"urn:ure:t6:occ:callsite:current-client:00979d52","call_va":"0x00979D52","target_va":"0x00A74EF0","section":".text","bytes":"e899b10f00","caller_id":"urn:ure:t6:occ:function:current-client:00979b20","target_id":"urn:ure:t6:occ:function:current-client:00a74ef0"},{"id":"urn:ure:t6:occ:callsite:current-client:00979d5b","call_va":"0x00979D5B","target_va":"0x0056AFB0","section":".text","bytes":"e85012bfff","caller_id":"urn:ure:t6:occ:function:current-client:00979b20","target_id":"urn:ure:t6:occ:function:current-client:0056afb0"},{"id":"urn:ure:t6:occ:callsite:current-client:00979d90","call_va":"0x00979D90","target_va":"0x006A0940","section":".text","bytes":"e8ab6bd2ff","caller_id":"urn:ure:t6:occ:function:current-client:00979d90","target_id":"urn:ure:t6:occ:function:current-client:006a0940"},{"id":"urn:ure:t6:occ:callsite:current-client:00979dcd","call_va":"0x00979DCD","target_va":"0x0042E5D0","section":".text","bytes":"e8fe47abff","caller_id":"urn:ure:t6:occ:function:current-client:00979d90","target_id":"urn:ure:t6:occ:function:current-client:0042e5d0"}] AS rows
