lient:0088bcf0","va":"0x0088BCF0","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:0088c9a0","va":"0x0088C9A0","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:0088ca20","va":"0x0088CA20","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:0088ca90","va":"0x0088CA90","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:0088cb00","va":"0x0088CB00","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:0088cbc0","va":"0x0088CBC0","section":".text","basis":"direct-call-target;post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:0088d2c0","va":"0x0088D2C0","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:0088d3e0","va":"0x0088D3E0","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"},{"id":"urn:ure:t6:occ:function:current-client:0088d460","va":"0x0088D460","section":".text","basis":"post-int3-padding","strongest_basis":"post-int3-padding"},{"id":"urn:ure:t6:occ:function:current-client:0088d470","va":"0x0088D470","section":".text","basis":"direct-call-target","strongest_basis":"direct-call-target"}] AS rows
UNWIND rows AS row
MERGE (n:KGNode {id:row.id})
ON CREATE SET n.kind='re:FunctionOccurrence', n.namespace='t6', n.build_id=b.id, n.artifact_id=a.id,
    n.display_name='sub_'+substring(row.va,2), n.address_space='va', n.address_start=row.va
SET n.entry_basis=row.basis, n.entry_strongest_basis=row.strongest_basis,
    n.boundary_state=CASE WHEN coalesce(n.boundary_state,'') STARTS WITH 'exact-' THEN n.boundary_state ELSE 'entry-only-mechanical-inventory' END,
    n.producer=CASE WHEN n.producer IS NULL THEN 't6-current-client-whole-image-mechanical-inventory-v1' ELSE n.producer END
MERGE (b)-[:HAS_OCCURRENCE]->(n)
MERGE (n)-[:DEFINED_IN]->(a)
