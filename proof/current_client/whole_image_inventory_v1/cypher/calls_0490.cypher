id":"urn:ure:t6:occ:callsite:current-client:008f36ac","call_va":"0x008F36AC","target_va":"0x008F3660","section":".text","bytes":"e8afffffff","caller_id":"urn:ure:t6:occ:function:current-client:008f36a0","target_id":"urn:ure:t6:occ:function:current-client:008f3660"},{"id":"urn:ure:t6:occ:callsite:current-client:008f36ba","call_va":"0x008F36BA","target_va":"0x0047E070","section":".text","bytes":"e8b1a9b8ff","caller_id":"urn:ure:t6:occ:function:current-client:008f36a0","target_id":"urn:ure:t6:occ:function:current-client:0047e070"},{"id":"urn:ure:t6:occ:callsite:current-client:008f36c1","call_va":"0x008F36C1","target_va":"0x004AB5D0","section":".text","bytes":"e80a7fbbff","caller_id":"urn:ure:t6:occ:function:current-client:008f36a0","target_id":"urn:ure:t6:occ:function:current-client:004ab5d0"},{"id":"urn:ure:t6:occ:callsite:current-client:008f36d0","call_va":"0x008F36D0","target_va":"0x006C2990","section":".text","bytes":"e8bbf2dcff","caller_id":"urn:ure:t6:occ:function:current-client:008f36a0","target_id":"urn:ure:t6:occ:function:current-client:006c2990"},{"id":"urn:ure:t6:occ:callsite:current-client:008f371e","call_va":"0x008F371E","target_va":"0x006C2990","section":".text","bytes":"e86df2dcff","caller_id":"urn:ure:t6:occ:function:current-client:008f36a0","target_id":"urn:ure:t6:occ:function:current-client:006c2990"},{"id":"urn:ure:t6:occ:callsite:current-client:008f3732","call_va":"0x008F3732","target_va":"0x006C2990","section":".text","bytes":"e859f2dcff","caller_id":"urn:ure:t6:occ:function:current-client:008f36a0","target_id":"urn:ure:t6:occ:function:current-client:006c2990"}] AS rows
