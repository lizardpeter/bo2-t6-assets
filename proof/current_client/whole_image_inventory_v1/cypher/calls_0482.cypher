id":"urn:ure:t6:occ:callsite:current-client:008d4a22","call_va":"0x008D4A22","target_va":"0x008CFCF0","section":".text","bytes":"e8c9b2ffff","caller_id":"urn:ure:t6:occ:function:current-client:008d43d0","target_id":"urn:ure:t6:occ:function:current-client:008cfcf0"},{"id":"urn:ure:t6:occ:callsite:current-client:008d4a29","call_va":"0x008D4A29","target_va":"0x008CE890","section":".text","bytes":"e8629effff","caller_id":"urn:ure:t6:occ:function:current-client:008d43d0","target_id":"urn:ure:t6:occ:function:current-client:008ce890"},{"id":"urn:ure:t6:occ:callsite:current-client:008d4a34","call_va":"0x008D4A34","target_va":"0x008CFCF0","section":".text","bytes":"e8b7b2ffff","caller_id":"urn:ure:t6:occ:function:current-client:008d43d0","target_id":"urn:ure:t6:occ:function:current-client:008cfcf0"},{"id":"urn:ure:t6:occ:callsite:current-client:008d4a3b","call_va":"0x008D4A3B","target_va":"0x008CE890","section":".text","bytes":"e8509effff","caller_id":"urn:ure:t6:occ:function:current-client:008d43d0","target_id":"urn:ure:t6:occ:function:current-client:008ce890"},{"id":"urn:ure:t6:occ:callsite:current-client:008d4a46","call_va":"0x008D4A46","target_va":"0x008CFCF0","section":".text","bytes":"e8a5b2ffff","caller_id":"urn:ure:t6:occ:function:current-client:008d43d0","target_id":"urn:ure:t6:occ:function:current-client:008cfcf0"},{"id":"urn:ure:t6:occ:callsite:current-client:008d4a53","call_va":"0x008D4A53","target_va":"0x008CFCF0","section":".text","bytes":"e898b2ffff","caller_id":"urn:ure:t6:occ:function:current-client:008d43d0","target_id":"urn:ure:t6:occ:function:current-client:008cfcf0"}] AS rows
UNWIND rows AS row
MATCH (target:KGNode {id:row.target_id})
MERGE (c:KGNode {id:row.id})
SET c.kind='core:Occurrence', c.occurrence_type='direct-callsite', c.namespace='t6', c.build_id=b.id, c.artifact_id=a.id,
