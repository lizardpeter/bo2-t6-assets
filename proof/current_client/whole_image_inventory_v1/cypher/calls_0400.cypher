id":"urn:ure:t6:occ:callsite:current-client:00824102","call_va":"0x00824102","target_va":"0x0045BAF0","section":".text","bytes":"e8e979c3ff","caller_id":"urn:ure:t6:occ:function:current-client:00824050","target_id":"urn:ure:t6:occ:function:current-client:0045baf0"},{"id":"urn:ure:t6:occ:callsite:current-client:00824116","call_va":"0x00824116","target_va":"0x004CBCC0","section":".text","bytes":"e8a57bcaff","caller_id":"urn:ure:t6:occ:function:current-client:00824050","target_id":"urn:ure:t6:occ:function:current-client:004cbcc0"},{"id":"urn:ure:t6:occ:callsite:current-client:00824124","call_va":"0x00824124","target_va":"0x00598640","section":".text","bytes":"e81745d7ff","caller_id":"urn:ure:t6:occ:function:current-client:00824050","target_id":"urn:ure:t6:occ:function:current-client:00598640"},{"id":"urn:ure:t6:occ:callsite:current-client:00824132","call_va":"0x00824132","target_va":"0x00633400","section":".text","bytes":"e8c9f2e0ff","caller_id":"urn:ure:t6:occ:function:current-client:00824050","target_id":"urn:ure:t6:occ:function:current-client:00633400"},{"id":"urn:ure:t6:occ:callsite:current-client:0082413f","call_va":"0x0082413F","target_va":"0x0045D840","section":".text","bytes":"e8fc96c3ff","caller_id":"urn:ure:t6:occ:function:current-client:00824050","target_id":"urn:ure:t6:occ:function:current-client:0045d840"},{"id":"urn:ure:t6:occ:callsite:current-client:0082414a","call_va":"0x0082414A","target_va":"0x004560B0","section":".text","bytes":"e8611fc3ff","caller_id":"urn:ure:t6:occ:function:current-client:00824050","target_id":"urn:ure:t6:occ:function:current-client:004560b0"}] AS rows
