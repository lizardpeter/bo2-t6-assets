id":"urn:ure:t6:occ:callsite:current-client:00975d92","call_va":"0x00975D92","target_va":"0x0050DB10","section":".text","bytes":"e8797db9ff","caller_id":"urn:ure:t6:occ:function:current-client:00975d30","target_id":"urn:ure:t6:occ:function:current-client:0050db10"},{"id":"urn:ure:t6:occ:callsite:current-client:00975db7","call_va":"0x00975DB7","target_va":"0x00975D30","section":".text","bytes":"e874ffffff","caller_id":"urn:ure:t6:occ:function:current-client:00975db0","target_id":"urn:ure:t6:occ:function:current-client:00975d30"},{"id":"urn:ure:t6:occ:callsite:current-client:00975dd7","call_va":"0x00975DD7","target_va":"0x00975D30","section":".text","bytes":"e854ffffff","caller_id":"urn:ure:t6:occ:function:current-client:00975dd0","target_id":"urn:ure:t6:occ:function:current-client:00975d30"},{"id":"urn:ure:t6:occ:callsite:current-client:00975e04","call_va":"0x00975E04","target_va":"0x005FB2F0","section":".text","bytes":"e8e754c8ff","caller_id":"urn:ure:t6:occ:function:current-client:00975df0","target_id":"urn:ure:t6:occ:function:current-client:005fb2f0"},{"id":"urn:ure:t6:occ:callsite:current-client:00975e0c","call_va":"0x00975E0C","target_va":"0x00A74EF0","section":".text","bytes":"e8dff00f00","caller_id":"urn:ure:t6:occ:function:current-client:00975df0","target_id":"urn:ure:t6:occ:function:current-client:00a74ef0"},{"id":"urn:ure:t6:occ:callsite:current-client:00975e26","call_va":"0x00975E26","target_va":"0x00682340","section":".text","bytes":"e815c5d0ff","caller_id":"urn:ure:t6:occ:function:current-client:00975df0","target_id":"urn:ure:t6:occ:function:current-client:00682340"}] AS rows
