    rep.ghidra_name=row.ghidra_name,
    rep.validation_gate='exact-retail-entry+provenance-safe-xbuild-hint'
MERGE (n)-[:`core:HAS_REPRESENTATION`]->(rep)
MERGE (e)-[:EVIDENCE_FOR]->(rep)
